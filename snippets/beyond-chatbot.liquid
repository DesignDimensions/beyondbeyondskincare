{% comment %}
  Beyond Beyond skincare assistant widget.
  Include once, near the end of theme.liquid, before </body>:
    {% render 'beyond-chatbot' %}
{% endcomment %}

{{ 'beyond-chatbot.css' | asset_url | stylesheet_tag }}

<div class="bb-chat">
  <button id="bb-chat-launcher" class="bb-chat-launcher" aria-label="Open skincare assistant chat" type="button">
    <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
      <path d="M9 4c-2.8 0-5 2.2-5 5 0 2.5 1.8 4.5 4.1 4.9-.4 2.7-2.1 4.6-4.1 5.6l.8 1.5c3.4-1.5 6.2-4.6 6.2-9.5V9c0-2.8-2.2-5-5-5z" fill="#ffffff"/>
      <circle cx="17" cy="8" r="4" fill="#ffffff"/>
    </svg>
  </button>

  <div id="bb-chat-panel" class="bb-chat-panel" role="dialog" aria-label="Beyond Beyond skincare assistant">
    <div class="bb-chat-header">
      <div>
        <div class="bb-chat-header-title">beyond, beyond.</div>
        <div class="bb-chat-header-sub">Skincare Assistant</div>
      </div>
      <button id="bb-chat-close" class="bb-chat-close" aria-label="Close chat" type="button">
        <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" width="20" height="20">
          <path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
        </svg>
      </button>
    </div>

    <div id="bb-chat-body" class="bb-chat-body">
      <p id="bb-chat-intro" class="bb-chat-intro">
        Hi! I can help you find the right product, explain ingredients, or build a routine — ask me anything about Beyond Beyond skincare.
      </p>
    </div>

    <div id="bb-chat-chips" class="bb-chips"></div>

    <div class="bb-chat-input-row">
      <input
        id="bb-chat-input"
        class="bb-chat-input"
        type="text"
        placeholder="Ask about a product or concern…"
        autocomplete="off"
      />
      <button id="bb-chat-send" class="bb-chat-send" aria-label="Send message" type="button">
        <svg style="transform: rotate(180deg)" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M4 12l16-7-6 7 6 7-16-7z" fill="currentColor"/>
        </svg>
      </button>
    </div>
  </div>
</div>

<script src="{{ 'beyond-chatbot.js' | asset_url }}" defer></script>
