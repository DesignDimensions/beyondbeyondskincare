{%- comment -%}
  Free gift auto-add
  ------------------
  Shopify's automatic "buy X get Y" discounts only *price* a gift at zero — they
  never put it in the cart. This snippet resolves the offers below into variant
  IDs at render time and installs a tiny cart-request interceptor. `free-gift.js`
  does the actual add/remove through the native Cart AJAX API, so GoKwik's
  KwikCart drawer keeps owning the cart UI.

  One offer per line:

      trigger-handle: gift-handle | another-gift-handle

  Where an offer grants several items, Shopify's discount points at a single
  hamper product that bundles them — so every offer here grants exactly one
  product. Two offers do share a gift (on-the-go and the-essential-edit both
  grant the lip butter); free-gift.js groups those by gift product so the
  entitlements add up and the discounts are counted once each, not once per
  offer.

  These must mirror the Buy-X-Get-Y automatic discounts in Shopify admin. The
  script only ever keeps a gift the discount actually pays for, so an offer
  listed here without a matching discount simply does nothing.
{%- endcomment -%}

{%- capture free_gift_offers -%}
the-travel-edit: beauty-bag
the-plump-protect-edit: beauty-bag
the-daily-essentials: beauty-bag
the-ultimate-night-repair-super-cream-1: beauty-bag-jelly-cleanser-mini
the-morning-edit: lip-butter-beauty-bag
the-evening-edit: hydro-active-day-cream-mini-cleanser-jelly-mini-beauty-bag
on-the-go: moisture-surge-lip-butter
the-essential-edit: moisture-surge-lip-butter
{%- endcapture -%}

{%- liquid
  assign offer_lines = free_gift_offers | newline_to_br | strip_newlines | split: '<br />'
  assign resolved_rules = ''
-%}

{%- capture free_gift_rules_json -%}
  {%- for offer_line in offer_lines -%}
    {%- assign offer = offer_line | strip -%}
    {%- if offer == blank -%}{% continue %}{%- endif -%}

    {%- assign offer_parts = offer | split: ':' -%}
    {%- assign trigger_handle = offer_parts[0] | strip -%}
    {%- assign trigger_product = all_products[trigger_handle] -%}
    {%- if trigger_product.id == blank -%}{% continue %}{%- endif -%}

    {%- assign gift_handles = offer_parts[1] | split: '|' -%}
    {%- for gift_handle_raw in gift_handles -%}
      {%- assign gift_handle = gift_handle_raw | strip -%}
      {%- assign gift_product = all_products[gift_handle] -%}
      {%- assign gift_variant = gift_product.selected_or_first_available_variant | default: gift_product.variants.first -%}
      {%- if gift_variant.id -%}
        {%- unless resolved_rules == '' -%},{%- endunless -%}
        {%- assign resolved_rules = resolved_rules | append: 'x' -%}
        {
          "id": {{ trigger_handle | append: '--' | append: gift_handle | json }},
          "triggerHandle": {{ trigger_handle | json }},
          "triggerProductId": {{ trigger_product.id | json }},
          "giftHandle": {{ gift_handle | json }},
          "giftProductId": {{ gift_product.id | json }},
          "giftVariantId": {{ gift_variant.id | json }},
          "giftTitle": {{ gift_product.title | json }},
          "giftAvailable": {{ gift_variant.available | json }},
          "giftQuantity": 1,
          {%- comment -%}
            Gift count follows the trigger quantity: 2 Morning Edits earn 2 bags.
            Overshoot is impossible either way — free-gift.js reads back how far
            the discount actually reached and hands back anything it did not
            cover. `maxQuantity` is an optional hard ceiling per offer.
          {%- endcomment -%}
          "multiply": true,
          "maxQuantity": null
        }
      {%- endif -%}
    {%- endfor -%}
  {%- endfor -%}
{%- endcapture -%}

{%- if resolved_rules != '' -%}
  <script>
    window.BBFreeGift = window.BBFreeGift || {};
    window.BBFreeGift.config = {
      rules: [{{ free_gift_rules_json }}],
      routes: {
        cart: {{ routes.cart_url | append: '.js' | json }},
        add: {{ routes.cart_add_url | append: '.js' | json }},
        change: {{ routes.cart_change_url | append: '.js' | json }},
        root: {{ routes.root_url | json }}
      },
      cartPath: {{ routes.cart_url | json }},
      // Property stamped on the gift line so it stays distinct from a lip butter
      // the customer paid for. Leading underscore keeps it hidden at checkout.
      property: '_free_gift',
      // Re-adding a gift the customer just deleted would fight them, so a manual
      // removal sticks until the trigger product leaves the cart. Set to false
      // if the gift must always be present.
      respectManualRemoval: true,
      // Pull the gift line back to the entitled quantity if it gets edited.
      lockGiftQuantity: true,
      // Stand down for units of the gift product already in the cart, whoever
      // put them there — the customer, KwikCart's own gift module, another app.
      // Without this, two mechanisms granting the same gift each add a line and
      // the shopper sees the product twice, once free and once charged.
      deferToExistingUnits: true,
      // The freebie discounts in Shopify admin, named exactly as they appear
      // there. Naming them lets the script read precisely how many units each
      // one covered, so an unrelated promotion on the same product is never
      // mistaken for gift coverage. Rename one in admin and it must be renamed
      // here too — otherwise the script falls back to counting 100%-off
      // allocations, which is safe but less precise.
      discountTitles: [
        'The Travel Edit Freebies',
        'Night Super Cream Freebies',
        'The Morning Edit Freebies',
        'The Evening Edit Freebies',
        'On The Go Freebies',
        'The Essential Edit Freebies'
      ],
      debug: false
    };
  </script>

  {%- comment -%}
    Inline on purpose: the interceptor has to wrap fetch/XHR before KwikCart or
    any theme script fires a cart request. The engine itself is deferred.
  {%- endcomment -%}
  <script>
    (function () {
      var NS = window.BBFreeGift;
      if (NS.intercepted) return;
      NS.intercepted = true;

      var CART_MUTATION = /\/cart\/(add|change|update|clear)(\.js|\.json)?(\?|$)/i;

      NS.rawFetch = window.fetch ? window.fetch.bind(window) : null;
      NS.pending = false;
      NS.handler = null;

      NS.isCartMutation = function (url) {
        if (!url) return false;
        try {
          return CART_MUTATION.test(String(url).split('#')[0]);
        } catch (e) {
          return false;
        }
      };

      // Hands off to free-gift.js once it has loaded; otherwise remembers that a
      // mutation happened so the engine can reconcile as soon as it boots.
      NS.notify = function (url) {
        if (typeof NS.handler === 'function') {
          try {
            return Promise.resolve(NS.handler(url));
          } catch (e) {
            return Promise.resolve();
          }
        }
        NS.pending = true;
        return Promise.resolve();
      };

      if (NS.rawFetch) {
        window.fetch = function (input, init) {
          var url = '';
          try {
            url = typeof input === 'string' ? input : (input && input.url) || '';
          } catch (e) {}

          var result = NS.rawFetch(input, init);
          if (!NS.isCartMutation(url)) return result;

          // Settle the gift line *before* the caller sees its response, so the
          // drawer that opens on add-to-cart already renders the complete cart.
          // The response body is never read here, so callers get it intact.
          return result.then(function (response) {
            if (!response || !response.ok) return response;
            return NS.notify(url).then(
              function () { return response; },
              function () { return response; }
            );
          });
        };
      }

      var XHR = window.XMLHttpRequest;
      if (XHR && XHR.prototype) {
        var open = XHR.prototype.open;
        XHR.prototype.open = function (method, url) {
          try {
            this.__bbGiftUrl = NS.isCartMutation(url) ? url : null;
          } catch (e) {}
          return open.apply(this, arguments);
        };

        var send = XHR.prototype.send;
        XHR.prototype.send = function () {
          var xhr = this;
          if (xhr.__bbGiftUrl) {
            xhr.addEventListener('load', function () {
              if (xhr.status >= 200 && xhr.status < 300) NS.notify(xhr.__bbGiftUrl);
            });
          }
          return send.apply(this, arguments);
        };
      }
    })();
  </script>

  <script src="{{ 'free-gift.js' | asset_url }}" defer="defer"></script>
{%- endif -%}
