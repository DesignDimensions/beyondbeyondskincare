<script>
  $(document).ready(function() {
    $('#triggerVideo').on('click', function () {
      $('#overlayVideo').fadeIn(300);
      $("body").css("overflow-y","hidden");
      });
    $('#closeVideo').click(function() {
      $('#overlayVideo').fadeOut(300);
        $("body").css("overflow-y","scroll");
      });
    $(document).mouseup(function (e) {
      var popup = $("#popupVideo");
        if (!$('#triggerVideo').is(e.target) && !popup.is(e.target) && popup.has(e.target).length == 0) {
          $('#overlayVideo').fadeOut(300);
          $("body").css("overflow-y","scroll");
        }
      });
    });
</script>

<script>
  $(function () {
  const $tooltip = $('.tooltip');
  const PADDING = 16;

  $('.ingredientsOverviewSec .ingreInfo').on('click', function (e) {
    e.stopPropagation();

    const $icon = $(this);
    const text = $icon.data('info');
    const offset = $icon.offset();
    const iconWidth = $icon.outerWidth();
    const scrollTop = $(window).scrollTop();
    const windowWidth = $(window).width();

    $tooltip.text(text).show();

    const tooltipWidth = $tooltip.outerWidth();
    const tooltipHeight = $tooltip.outerHeight();

    let top = offset.top - scrollTop - tooltipHeight - 10;
    let left = offset.left + iconWidth / 2 - tooltipWidth / 2;

    left = Math.max(
      PADDING,
      Math.min(left, windowWidth - tooltipWidth - PADDING)
    );

    if (top < PADDING) {
      top = offset.top - scrollTop + 28;
    }

    const iconCenter = offset.left + iconWidth / 2;
    const arrowLeft = iconCenter - left;

    const safeArrowLeft = Math.max(
      12,
      Math.min(arrowLeft, tooltipWidth - 12)
    );

    $tooltip.css({
      top,
      left,
      '--arrow-left': `${safeArrowLeft}px`
    });
  });

  // Hide on document click
  $(document).on('click', function () {
    $tooltip.hide();
  });

  // Prevent closing when clicking tooltip
  $tooltip.on('click', function (e) {
    e.stopPropagation();
  });

  // ✅ Hide tooltip on scroll
  $(window).on('scroll', function () {
    $tooltip.hide();
  });
});
</script>

