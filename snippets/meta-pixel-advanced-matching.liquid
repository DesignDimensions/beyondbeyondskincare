{%- comment -%}
  Manual advanced matching for the Meta pixel.

  Builds `window.metaPixelAdvancedMatching`, the object passed as the third
  parameter to `fbq('init', ...)`. This snippet MUST be rendered before the
  pixel base code: Meta's docs are explicit that advanced matching values only
  count when they are present in the base code at init time, and a second
  `fbq('init', ...)` for an already-initialized pixel is ignored.

  That constraint shapes the whole design:

    * `external_id` is a first-party ID minted for every visitor, logged in or
      not, so every event carries at least one matching parameter.
    * Real identity (email, phone, name, address) comes from the signed-in
      customer when there is one.
    * Anything the shopper types later is normalized, persisted, and folded
      into the init on the NEXT page view — the only place Meta honours it.

  Values are normalized to Meta's rules here; the pixel hashes them with
  SHA-256 in the browser, so no raw PII is transmitted.
{%- endcomment -%}
<script>
  window.metaPixel = window.metaPixel || {};

  (function () {
    // Fallback dialling code for phone numbers stored without one (store is IN).
    var DEFAULT_DIAL_CODE = '91';
    var STORAGE_KEY = 'metaPixelAdvancedMatching';
    var EXTERNAL_ID_KEY = 'metaPixelExternalId';
    var EXTERNAL_ID_COOKIE = '_bb_ext_id';
    var TWO_YEARS_IN_SECONDS = 63072000;

    /* -------------------------------------------------------------- storage */

    function readStorage(key) {
      try {
        return window.localStorage.getItem(key);
      } catch (_) {
        return null;
      }
    }

    function writeStorage(key, value) {
      try {
        window.localStorage.setItem(key, value);
      } catch (_) {
        // Private mode or quota exceeded — cookie below still carries the ID.
      }
    }

    function readCookie(name) {
      var match = document.cookie.match(new RegExp('(?:^|; )' + name + '=([^;]*)'));
      return match ? decodeURIComponent(match[1]) : '';
    }

    function writeCookie(name, value) {
      document.cookie =
        name + '=' + encodeURIComponent(value) +
        '; path=/; max-age=' + TWO_YEARS_IN_SECONDS +
        '; SameSite=Lax' + (location.protocol === 'https:' ? '; Secure' : '');
    }

    /* --------------------------------------------------------- normalization */

    function text(value) {
      if (typeof value === 'number') return String(value);
      return typeof value === 'string' ? value.trim() : '';
    }

    // Letters only: Meta strips punctuation, digits and whitespace from names.
    function letters(value) {
      return text(value)
        .toLowerCase()
        .replace(/[^a-zà-ÿ]/g, '');
    }

    function email(value) {
      var normalized = text(value).toLowerCase();
      return /^[^\s@]+@[^\s@]+\.[a-z]{2,}$/.test(normalized) ? normalized : '';
    }

    // Digits only, including country code — Meta cannot match a bare local number.
    function phone(value) {
      var digits = text(value).replace(/\D/g, '').replace(/^0+/, '');
      if (!digits) return '';
      if (digits.length === 10) digits = DEFAULT_DIAL_CODE + digits;
      return digits.length >= 10 && digits.length <= 15 ? digits : '';
    }

    function state(value, countryCode) {
      var normalized = letters(value);
      // Meta wants the two-letter code; a full US state name would not match.
      if (countryCode === 'us' && normalized.length !== 2) return '';
      return normalized;
    }

    function zip(value, countryCode) {
      var normalized = text(value).toLowerCase().replace(/\s/g, '');
      if (countryCode === 'us') return normalized.split('-')[0].slice(0, 5);
      return normalized;
    }

    function country(value) {
      var normalized = text(value).toLowerCase();
      return /^[a-z]{2}$/.test(normalized) ? normalized : '';
    }

    function gender(value) {
      var normalized = text(value).toLowerCase().charAt(0);
      return normalized === 'f' || normalized === 'm' ? normalized : '';
    }

    function birthday(value) {
      var digits = text(value).replace(/\D/g, '');
      return digits.length === 8 ? digits : '';
    }

    // Accepts loose input (`{ email, phone, firstName, ... }`) or already-keyed
    // input (`{ em, ph, fn, ... }`) and returns only valid, Meta-shaped keys.
    window.metaPixel.normalizeAdvancedMatching = function (raw) {
      var input = raw || {};
      var countryCode = country(input.country || input.countryCode);

      var normalized = {
        em: email(input.em || input.email),
        ph: phone(input.ph || input.phone),
        fn: letters(input.fn || input.firstName),
        ln: letters(input.ln || input.lastName),
        ct: letters(input.ct || input.city),
        st: state(input.st || input.province || input.state, countryCode),
        zp: zip(input.zp || input.zip || input.postcode, countryCode),
        country: countryCode,
        ge: gender(input.ge || input.gender),
        db: birthday(input.db || input.birthday),
        external_id: text(input.external_id || input.externalId || input.customerId)
      };

      Object.keys(normalized).forEach(function (key) {
        if (!normalized[key] || normalized[key] === '0') delete normalized[key];
      });

      return normalized;
    };

    /* -------------------------------------------------------- external_id */

    // A stable first-party ID for every visitor. Meta accepts "any unique ID
    // from the advertiser" here, so this guarantees 100% of events carry a
    // matching parameter instead of only the small logged-in share.
    function resolveExternalId() {
      var existing = readCookie(EXTERNAL_ID_COOKIE) || readStorage(EXTERNAL_ID_KEY) || '';

      if (!/^[a-z0-9-]{8,64}$/i.test(existing)) {
        existing =
          window.crypto && typeof window.crypto.randomUUID === 'function'
            ? window.crypto.randomUUID()
            : 'bb-' + Date.now().toString(36) + '-' + Math.random().toString(36).slice(2, 12);
      }

      writeCookie(EXTERNAL_ID_COOKIE, existing);
      writeStorage(EXTERNAL_ID_KEY, existing);
      return existing;
    }

    /* ------------------------------------------------------------ identify */

    window.metaPixel.readStoredAdvancedMatching = function () {
      try {
        return JSON.parse(readStorage(STORAGE_KEY)) || {};
      } catch (_) {
        return {};
      }
    };

    // Records details the shopper just gave us. The pixel is already locked in
    // for this page view, so the value is persisted for the next init and, as a
    // best-effort supplement, attached to events fired from here on.
    window.metaPixel.identify = function (raw) {
      var normalized = window.metaPixel.normalizeAdvancedMatching(raw);
      delete normalized.external_id; // Never let a form overwrite our own ID.

      var known = window.metaPixelAdvancedMatching || {};
      var changed = Object.keys(normalized).filter(function (key) {
        return normalized[key] !== known[key];
      });

      if (!changed.length) return known;

      var merged = Object.assign({}, window.metaPixel.readStoredAdvancedMatching(), normalized);
      writeStorage(STORAGE_KEY, JSON.stringify(merged));

      window.metaPixelAdvancedMatching = Object.assign({}, known, normalized);
      window.metaPixel.hashUserData(normalized);

      return window.metaPixelAdvancedMatching;
    };

    // Kept for older call sites.
    window.metaPixel.rememberAdvancedMatching = window.metaPixel.identify;

    /* ------------------------------------------------- per-event user_data */

    // `window.metaPixelUserData` is passed as the fourth `fbq('track', ...)`
    // argument. Values are SHA-256 hashed here rather than sent raw, so nothing
    // identifiable leaves the browser either way.
    window.metaPixelUserData = window.metaPixelUserData || {};

    function sha256(value) {
      if (!window.crypto || !window.crypto.subtle) return Promise.resolve('');
      return window.crypto.subtle
        .digest('SHA-256', new TextEncoder().encode(value))
        .then(function (buffer) {
          return Array.prototype.map
            .call(new Uint8Array(buffer), function (byte) {
              return byte.toString(16).padStart(2, '0');
            })
            .join('');
        })
        .catch(function () {
          return '';
        });
    }

    window.metaPixel.hashUserData = function (normalized) {
      Object.keys(normalized || {}).forEach(function (key) {
        if (key === 'external_id') {
          window.metaPixelUserData[key] = normalized[key];
          return;
        }
        sha256(normalized[key]).then(function (hashed) {
          if (hashed) window.metaPixelUserData[key] = hashed;
        });
      });
    };

    /* ------------------------------------------------------- init payload */

    var customer = window.metaPixel.normalizeAdvancedMatching({
      email: {{ customer.email | json }},
      phone: {{ customer.phone | default: customer.default_address.phone | json }},
      firstName: {{ customer.first_name | default: customer.default_address.first_name | json }},
      lastName: {{ customer.last_name | default: customer.default_address.last_name | json }},
      city: {{ customer.default_address.city | json }},
      province: {{ customer.default_address.province_code | json }},
      zip: {{ customer.default_address.zip | json }},
      country: {{ customer.default_address.country_code | json }}
    });

    // Signed-in details outrank anything remembered from a form on this device.
    window.metaPixelAdvancedMatching = Object.assign(
      {},
      window.metaPixel.readStoredAdvancedMatching(),
      customer,
      { external_id: resolveExternalId() }
    );

    window.metaPixel.hashUserData(window.metaPixelAdvancedMatching);
  })();
</script>
