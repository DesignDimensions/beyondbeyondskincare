{%- liquid
  assign promo_images = false
  assign link_handle = link.title | downcase | handle
  assign is_bestseller_mega = false
  assign is_concern_mega = false
  assign is_sets_offers_mega = false
  if link_handle == 'bestseller' or link_handle == 'bestsellers'
    assign is_bestseller_mega = true
  elsif link_handle == 'concern' or link_handle == 'concerns'
    assign is_concern_mega = true
  elsif link_handle == 'sets-and-offers' or link_handle == 'sets-offers'
    assign is_sets_offers_mega = true
  endif
  if block.settings.promo_image_1 != blank or block.settings.promo_image_2 != blank
    assign promo_images = true
  endif
-%}
<mega-menu class="is-megamenu{% if is_bestseller_mega %} mega-menu--bestseller{% endif %}{% if is_concern_mega %} mega-menu--concern{% endif %}{% if is_sets_offers_mega %} mega-menu--sets-offers{% endif %}{% if promo_images %} mega-menu--has-promo{% endif %}{% if block.settings.show_menu_image %}{% if promo_images %} show-images{% else %} show-images-without-promo{% endif %}{% endif %}">
  <a href="{{ link.url }}" class="a header__menu-item{% if link.active or link.child_active %} header__active-menu-item{% endif %} header__menu-item--top list-menu__item focus-inset"{% if link.current %} aria-current="page"{% endif %}>
    {%- liquid
      assign item_title = link.title | escape
      if enable_highlight and highlight_labels contains item_title
        render 'highlight-text', hl_enable: true, hl_input: item_title, hl_phrases: highlight_labels, hl_style: highlight_style, hl_animateWrap: true
      else
        echo '<span class="label">'
        echo item_title
        echo '</span>'
      endif
    -%}
    <svg xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false" class="icon icon-caret" fill="none" viewBox="0 0 24 15">
      <path fill-rule="evenodd" clip-rule="evenodd" d="M12 15c-.3 0-.6-.1-.8-.4l-11-13C-.2 1.2-.1.5.3.2c.4-.4 1.1-.3 1.4.1L12 12.5 22.2.4c.4-.4 1-.5 1.4-.1.4.4.5 1 .1 1.4l-11 13c-.1.2-.4.3-.7.3z" fill="currentColor"></path>
    </svg>
  </a>
  {%- if link.links != blank or promo_images or is_bestseller_mega or is_concern_mega or is_sets_offers_mega -%}
    <div class="list-menu-dropdown hidden">
      <div class="page-width{% if block.settings.narrow %} page-width--inner{% endif %}">
        {%- capture sizes -%}(min-width: {{ settings.page_width }}px) {{ settings.page_width | minus: 130 | divided_by: 4 }}px, (min-width: 990px) calc((100vw - 10rem) / 4), (min-width: 750px) calc((100vw - 10rem) / 3), calc(100vw - 3rem){%- endcapture -%}

        {%- if is_bestseller_mega -%}
          {% render 'bestseller-mega-menu-content', link: link, block: block, sizes: sizes %}
        {%- elsif is_concern_mega -%}
          {% render 'sets-offers-mega-menu-content', link: link, block: block, sizes: sizes, menu_variant: 'concern' %}
        {%- elsif is_sets_offers_mega -%}
          {% render 'concern-mega-menu-content', link: link, block: block, sizes: sizes, menu_variant: 'sets_offers' %}
        {%- elsif link.links != blank -%}
          <div class="list-mega-menu">
            {%- for childlink in link.links -%}
              <div class="mega-menu__item">
                <a href="{{ childlink.url }}" class="mega-menu__item-link list-menu__item focus-inset{% if childlink.current %} list-menu__item--active{% endif %}"{% if childlink.current %} aria-current="page"{% endif %}>
                  {%- if childlink.type == 'collection_link' and childlink.object.image and block.settings.show_menu_image -%}
                    <div class="image-animate media media--wide">
                      {{ childlink.object.image | image_url: width: 1100 | image_tag:
                        loading: 'lazy',
                        class: 'motion-reduce',
                        sizes: sizes,
                        widths: '165, 360, 535, 750, 940, 1100',
                        is: 'lazy-image'
                      }}
                    </div>
                  {%- endif -%}
                  <div class="b header__menu-item">
                    <span class="label">{{ childlink.title | escape }}</span>
                  </div>
                </a>
      
                {%- if childlink.links != blank -%}
                  <ul class="list-menu-child list-menu">
                    {%- for grandchildlink in childlink.links -%}
                      <li>
                        <a href="{{ grandchildlink.url }}" class="header__menu-item list-menu__item focus-inset{% if grandchildlink.current %} list-menu__item--active{% endif %}"{% if grandchildlink.current %} aria-current="page"{% endif %}>
                          <span class="label">{{ grandchildlink.title | escape }}</span>
                        </a>
                      </li>
                    {%- endfor -%}
                  </ul>
                {%- endif -%}
              </div>
            {%- endfor -%}
            {%- if link.links.size < 4 -%}
              {% comment %} <div class="mega-menu__item mega-menu__item--blank"></div> {% endcomment %}
            {%- endif -%}
          </div>
        {%- endif -%}

        {%- if block.settings.promo_image_1 != blank and is_bestseller_mega == false -%}
          <div class="mega-menu__promo{% if block.settings.promo_overlay_content_1 %} mega-menu__promo--overlay{% endif %}">
            <a class="mega-menu__promo-link media-wrapper"{% if block.settings.promo_link_1 != blank %} href="{{ block.settings.promo_link_1 }}"{% else %} role="link" aria-disabled="true"{% endif %}>
              <div class="image-animate media media--{{ block.settings.promo_image_ratio_1 }}"
                style="--image-position: {{ block.settings.promo_image_position_1 }};{% if block.settings.promo_image_ratio_1 == 'adapt' %}--image-ratio-percent: {{ 1 | divided_by: block.settings.promo_image_1.aspect_ratio | times: 100 }}%;{% endif %}"
              >
                {{ block.settings.promo_image_1 | image_url: width: 1100 | image_tag:
                  loading: 'lazy',
                  class: 'motion-reduce',
                  sizes: sizes,
                  widths: '165, 360, 535, 750, 940, 1100',
                  is: 'lazy-image'
                }}
              </div>
              {%- if block.settings.promo_heading_1 != blank or block.settings.promo_text_1 != blank -%}
                <div class="mega-menu__promo-content">
                  {%- if block.settings.promo_heading_1 != blank -%}
                    <div class="mega-menu__promo-heading">
                      <span class="label">{{ block.settings.promo_heading_1  }}</span>
                    </div>
                  {%- endif -%}
                  <div class="mega-menu__promo-subheading">
                    <svg width="39" height="26" viewBox="0 0 39 26" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M16.5664 11.2031C16.5645 9.65743 16.7291 8.13521 17.1795 6.6506C17.9817 4.00625 19.5816 2.06878 22.1678 0.996971C23.6123 0.398536 25.1238 0.144018 26.6749 0.037521C27.9885 -0.052855 29.2904 0.0238423 30.583 0.226578C32.4643 0.521643 34.222 1.13815 35.6973 2.39804C36.753 3.29985 37.5151 4.40928 38.0393 5.69555C38.6773 7.25978 38.9157 8.89779 38.9841 10.5675C39.0632 12.4987 38.8551 14.399 38.2322 16.2353C37.5312 18.3003 36.2635 19.9271 34.3544 21.0111C33.307 21.6061 32.1736 21.9725 30.9851 22.1855C29.7955 22.399 28.5982 22.5187 27.3935 22.4781C26.0794 22.4337 24.7779 22.2842 23.499 21.9344C22.3759 21.6271 21.3383 21.1581 20.3945 20.4889C19.1649 19.6164 18.2665 18.4654 17.6529 17.0917C16.8156 15.2168 16.565 13.2334 16.5664 11.2036V11.2031Z" fill="#000"></path>
                    <path d="M7.29849 2.28085e-05C11.9428 0.0112587 15.0718 3.90866 15.0576 9.809C15.0415 16.4612 10.8837 22.4768 4.09918 25.3478L3.72498 24.5921C6.36298 22.8417 8.00098 20.2086 8.00636 18.0757C8.01808 13.3058 -0.0151227 13.2863 2.13852e-05 7.01027C0.00930324 3.12068 3.15536 -0.00974757 7.29849 2.28085e-05Z" fill="#000"></path>
                    </svg>
                    {{ block.settings.promo_text_1 }}</div>
                </div>
              {%- endif -%}
            </a>
          </div>
        {%- endif -%}

        {%- if block.settings.promo_image_2 != blank and is_bestseller_mega == false -%}
          <div class="mega-menu__promo{% if block.settings.promo_overlay_content_2 %} mega-menu__promo--overlay{% endif %}">
            <a class="mega-menu__promo-link media-wrapper"{% if block.settings.promo_link_2 != blank %} href="{{ block.settings.promo_link_2 }}"{% else %} role="link" aria-disabled="true"{% endif %}>
              <div class="image-animate media media--{{ block.settings.promo_image_ratio_2 }}"
                style="--image-position: {{ block.settings.promo_image_position_2 }};{% if block.settings.promo_image_ratio_2 == 'adapt' %}--image-ratio-percent: {{ 1 | divided_by: block.settings.promo_image_2.aspect_ratio | times: 100 }}%;{% endif %}"
              >
                {{ block.settings.promo_image_2 | image_url: width: 1100 | image_tag:
                  loading: 'lazy',
                  class: 'motion-reduce',
                  sizes: sizes,
                  widths: '165, 360, 535, 750, 940, 1100',
                  is: 'lazy-image'
                }}
              </div>
              {%- if block.settings.promo_heading_2 != blank or block.settings.promo_text_2 != blank -%}
                <div class="mega-menu__promo-content">
                  {%- if block.settings.promo_heading_2 != blank -%}
                    <div class="mega-menu__promo-heading">
                      <span class="label">{{ block.settings.promo_heading_2  }}</span>
                    </div>
                  {%- endif -%}
                  <div class="mega-menu__promo-subheading">{{ block.settings.promo_text_2 | escape }}</div>
                </div>
              {%- endif -%}
            </a>
          </div>
        {%- endif -%}
      </div>
    </div>
  {%- endif -%}
</mega-menu>
