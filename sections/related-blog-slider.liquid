{% if section.settings.show_blog_grid_sec != blank %}
<div class="blogGridSec">
  <div class="page-width">
    {% if section.settings.title != blank %}
    <div class="section__header">
      <h4 class="sub_title_name">{{ section.settings.title }}</h4>
    </div>
    {% endif %}
    <div class="blogList">
        <div class="blogGridSlider blogGridSlider_{{ section.id }}">
          <div class="swiper-wrapper">
            {%- for article in section.settings.blog.articles -%}
              <div class="swiper-slide">
                <div class="item_d">
                  <a href="{{ article.url }}">
                    <div class="blog_img">
                      <img src="{{ article.metafields.custom.main_mobile_image | img_url:"master" }}" class="">
                    </div>
                    <h4>{{ article.title }}</h4>
                  </a>
                </div>
              </div>
            {% endfor %}
          </div>
          <div class="swiperDotsButtons">
              <div class="swiper-button-prev" style="opacity:0">
                <svg width="11" height="18" viewBox="0 0 11 18" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M9.66602 1L1.66602 9L9.66602 17" stroke="#292929" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
                </svg>
              </div>
              <div class="swiper-pagination"></div>
              <div class="swiper-button-next"  style="opacity:0">
                <svg width="11" height="18" viewBox="0 0 11 18" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M1.33398 17L9.33399 9L1.33399 0.999999" stroke="#292929" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
                </svg>
              </div>
          </div>
        </div>
    </div>
  </div>
</div>
{% endif %}

<script>
    var swiper = new Swiper('.blogGridSlider_{{ section.id }}', {
      slidesPerView: 1.5,
      spaceBetween: 24,
      slidesOffsetBefore: 24,
      pagination: {
        el: '.swiper-pagination',
         clickable: true,
      },
      // Navigation arrows
      navigation: {
        nextEl: '.swiper-button-next',
        prevEl: '.swiper-button-prev',
        disabledClass: "is-disabled"
      },
      // And if we need scrollbar
      scrollbar: {
        el: '.swiper-scrollbar',
      },
          // Breakpoints
    breakpoints: {
      0: {  // from 480px and up
        slidesPerView: 1.5,
        spaceBetween: 24,
        slidesOffsetBefore: 24,
      },
      768: {  // from 768px and up
        slidesPerView: 3,
        spaceBetween: 40,
        slidesOffsetBefore: 0,
      },
      1000: { // from 1024px and up
        slidesPerView: 3,
        spaceBetween: 120,
        slidesOffsetBefore: 0,
      },
    }
    });
</script>

{% schema %}
{
  "name": "Related Blog Sec",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_blog_grid_sec",
      "label": "Show Blog Grid Sec",
      "default": true
    },
    {
      "type": "blog",
      "id": "blog",
      "label": "Blog"
    },
    {
      "type": "text",
      "id": "title",
      "label": "title"
    }
  ],
  "presets": [
    {
      "name": "Related Blog Sec",
      "category": "Custom"
    }
  ]
}
{% endschema %}