{%- liquid
  assign show_announcement_bar = true

  if section.blocks.size == 0
    assign show_announcement_bar = false
  endif

  if section.settings.only_homepage and request.page_type != 'index'
    assign show_announcement_bar = false
  endif

  assign announcement_height = 36
-%}

{%- if show_announcement_bar -%}
  {%- style -%}
    #shopify-section-{{ section.id }} {
      --section-padding-top: {{ section.settings.padding_top }}px;
      --section-padding-bottom: {{ section.settings.padding_bottom }}px;
      --gradient-background: {% if section.settings.gradient_background != blank %}{{ section.settings.gradient_background }}{% else %}{{ section.settings.colors_background }}{% endif %};
      --color-background: {{ section.settings.colors_background.red }}, {{ section.settings.colors_background.green }}, {{ section.settings.colors_background.blue }};
      --color-foreground: {{ section.settings.colors_text.red }}, {{ section.settings.colors_text.green }}, {{ section.settings.colors_text.blue }};
      --color-highlight: {{ section.settings.colors_highlight.red }}, {{ section.settings.colors_highlight.green }}, {{ section.settings.colors_highlight.blue }};
    }

    :root {
      --announcement-height: calc({{ announcement_height }}px + ({{ section.settings.padding_top | plus: section.settings.padding_bottom }}px * 0.75));
    }

    @media screen and (min-width: 990px) {
      :root {
        --announcement-height: {{ announcement_height | plus: section.settings.padding_top | plus: section.settings.padding_bottom }}px;
      }
    }
  {%- endstyle -%}
  {{ 'section-announcement-bar.css' | asset_url | stylesheet_tag }}

  <div class="announcement-bar top-header-announcement header-section--padding">
    <div class="page-width">
      <announcement-bar data-layout="{{ section.settings.layout }}" data-mobile-layout="{{ section.settings.mobile_layout }}" data-autorotate="{{ section.settings.autorotate }}" data-autorotate-speed="{{ section.settings.autorotate_speed }}" data-block-count="{{ section.blocks.size }}" data-speed="{{ section.settings.speed }}" data-direction="{{ section.settings.direction }}">
        {%- if section.settings.show_navigation -%}
          <button class="announcement__button announcement__button--prev" name="previous" aria-label="{{ 'general.slider.previous_slide' | t }}">
            {% render 'icon', icon: 'chevron-alt' %}
          </button>
        {%- endif -%}
        <div class="announcement-slider">
          {%- for block in section.blocks -%}
            <div class="announcement-slider__slide" style="--font-size: {{ block.settings.text_size }}px;" data-index="{{ forloop.index0 }}" {{ block.shopify_attributes }}>
              {%- if block.settings.link != blank -%}
                <a class="announcement-link" href="{{ block.settings.link }}">
              {%- endif -%}
                {%- if block.settings.text_on_mobile != blank -%}
                  <span class="announcement-text small-hide medium-hide">{{ block.settings.text }}</span>
                  <span class="announcement-text large-up-hide">{{ block.settings.text_on_mobile }}</span>
                {%- else -%}
                  <span class="announcement-text">{{ block.settings.text }}</span>
                {%- endif -%}
              {%- if block.settings.link != blank -%}
                </a>
              {%- endif -%}
            </div>
          {%- endfor -%}
        </div>
        {%- if section.settings.show_navigation -%}
          <button class="announcement__button announcement__button--next" name="next" aria-label="{{ 'general.slider.next_slide' | t }}">
            {% render 'icon', icon: 'chevron-alt' %}
          </button>
        {%- endif -%}
      </announcement-bar>
    </div>
  </div>

  {{ 'section-top-announcement-bar.css' | asset_url | stylesheet_tag }}
  
  {%- unless request.design_mode -%}
    <script src="{{ 'announcement-bar.js' | asset_url }}" defer="defer"></script>
  {%- endunless -%}
{%- endif -%}

{%- if request.design_mode -%}
  <script src="{{ 'announcement-bar.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

{% schema %}
{
  "name": "Top announcement bar",
  "class": "shopify-section-top-announcement-bar",
  "max_blocks": 6,
  "settings": [
    { "type": "checkbox", "id": "only_homepage", "label": "Show on homepage only", "default": false },
    { "type": "select", "id": "layout", "options": [
      { "value": "default", "label": "Default" },
      { "value": "marquee", "label": "Marquee" },
      { "value": "carousel", "label": "Carousel" }
    ], "default": "carousel", "label": "Desktop layout" },
    { "type": "select", "id": "mobile_layout", "options": [
      { "value": "marquee", "label": "Marquee" },
      { "value": "carousel", "label": "Carousel" }
    ], "default": "carousel", "label": "Mobile layout" },
    { "type": "checkbox", "id": "autorotate", "default": true, "label": "Auto rotate" },
    { "type": "range", "id": "autorotate_speed", "label": "Rotate every", "max": 9, "min": 3, "step": 2, "unit": "s", "default": 5 },
    { "type": "checkbox", "id": "show_navigation", "default": true, "label": "Show arrows" },
    { "type": "select", "id": "direction", "options": [
      { "value": "left", "label": "Left" },
      { "value": "right", "label": "Right" }
    ], "default": "left", "label": "Marquee direction" },
    { "type": "range", "id": "speed", "min": 0.5, "max": 2.5, "step": 0.1, "label": "Marquee speed", "unit": "x", "default": 1.6 },
    { "type": "color", "id": "colors_text", "label": "Text", "default": "#ffffff" },
    { "type": "color", "id": "colors_background", "label": "Background", "default": "#0107ef" },
    { "type": "color_background", "id": "gradient_background", "label": "Background gradient" },
    { "type": "color", "id": "colors_highlight", "label": "Highlight", "default": "#ffb503" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 36, "step": 2, "unit": "px", "label": "Top padding", "default": 20 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 36, "step": 2, "unit": "px", "label": "Bottom padding", "default": 20 }
  ],
  "blocks": [
    {
      "type": "announcement",
      "name": "Announcement",
      "settings": [
        { "type": "inline_richtext", "id": "text", "default": "Flat <strong>10% OFF</strong> sitewide", "label": "Text" },
        { "type": "inline_richtext", "id": "text_on_mobile", "label": "Text on mobile" },
        { "type": "range", "id": "text_size", "default": 20, "min": 10, "max": 28, "step": 1, "label": "Text size", "unit": "px" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [
    { "name": "Top announcement bar" }
  ],
  "enabled_on": {
    "groups": ["header"]
  }
}
{% endschema %}
