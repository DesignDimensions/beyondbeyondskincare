    </div>
    <div class="NNNCLists">
      <div class="item_d">
        <div class="icon_d"><img src="https://cdn.shopify.com/s/files/1/0715/1157/2666/files/Frame_40410.svg?v=1763362183"></div>
        <div class="text_d">Formulated & Tested By Dermatologist</div>
      </div>
      <div class="item_d">
        <div class="icon_d"><img src="https://cdn.shopify.com/s/files/1/0715/1157/2666/files/Frame_40412.svg?v=1763362240"></div>
        <div class="text_d">Cruelty Free</div>
