{%- liquid
  assign s = section.settings

  assign gif_src = ''
  if s.gif_url != blank
    assign gif_src = s.gif_url
  elsif s.gif != blank
    comment
      The raw CDN path, deliberately untransformed: putting an animated GIF
      through image_url can flatten it to a single frame.
    endcomment
    assign gif_src = s.gif.src
  endif

  assign gif_src_mobile = ''
  if s.gif_url_mobile != blank
    assign gif_src_mobile = s.gif_url_mobile
  elsif s.gif_mobile != blank
    assign gif_src_mobile = s.gif_mobile.src
  endif

  comment
    Either one on its own is enough: whichever is missing falls back to the other.
  endcomment
  if gif_src_mobile == blank
    assign gif_src_mobile = gif_src
  endif
  if gif_src == blank
    assign gif_src = gif_src_mobile
  endif
-%}

{%- if s.enabled and gif_src != blank -%}
  {%- style -%}
    .rakhi-intro {
      position: fixed;
      inset: 0;
      z-index: 2147483000;
      display: flex;
      align-items: center;
      justify-content: center;
      background-color: {{ s.background_color }};
      opacity: 1;
      transition: opacity {{ s.fade_ms }}ms ease;
      overflow: hidden;
      overscroll-behavior: contain;
      -webkit-tap-highlight-color: transparent;
    }

    .no-js .rakhi-intro,
    .rakhi-intro--skip .rakhi-intro {
      display: none;
    }

    .rakhi-intro--out {
      opacity: 0;
      pointer-events: none;
    }

    /* Full-bleed: the GIF spans the viewport edge to edge and the flex
       container centres whatever height its aspect ratio gives it. */
    .rakhi-intro__media {
      display: block;
      flex: 0 0 auto;
      width: 100%;
      max-width: none;
      height: auto;
      opacity: 0;
      transition: opacity 220ms ease;
    }

    .rakhi-intro__media.is-ready {
      opacity: 1;
    }

    .rakhi-intro__skip {
      position: absolute;
      bottom: 28px;
      left: 50%;
      transform: translateX(-50%);
      padding: 8px 14px;
      border: 0;
      background: none;
      color: {{ s.skip_color }};
      font-size: 11px;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      cursor: pointer;
      opacity: 0;
      transition: opacity 400ms ease;
    }

    .rakhi-intro__skip.is-ready {
      opacity: 0.65;
    }

    .rakhi-intro__skip:hover,
    .rakhi-intro__skip:focus-visible {
      opacity: 1;
    }

    /* Holds the page still underneath while the intro plays. */
    html.rakhi-intro-lock,
    html.rakhi-intro-lock body {
      overflow: hidden !important;
    }
  {%- endstyle -%}

  {%- comment -%}
    Runs while the document is still parsing so a repeat visitor never sees a
    frame of the overlay, and so the page underneath is locked before paint.
  {%- endcomment -%}
  <script>
    window.rakhiIntro = (function () {
      var root = document.documentElement;
      var cfg = {
        id: {{ section.id | json }},
        srcDesktop: {{ gif_src | json }},
        srcMobile: {{ gif_src_mobile | json }},
        auto: {{ s.duration_mode | json }} === 'auto',
        fallback: {{ s.duration_ms | json }},
        hold: {{ s.hold_ms | json }},
        fade: {{ s.fade_ms | json }},
        freq: {{ s.frequency | json }},
        skip: {{ s.allow_skip | json }},
        design: !!(window.Shopify && window.Shopify.designMode)
      };
      cfg.key = 'rakhi-intro:' + cfg.id;

      /* Picked once, before the fetch below, so only the artwork that will
         actually be shown is downloaded. */
      function mobile() {
        return !!(window.matchMedia && window.matchMedia('(max-width: 749px)').matches);
      }

      cfg.src = mobile() ? cfg.srcMobile : cfg.srcDesktop;

      function reduced() {
        return !!(window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches);
      }

      function seen() {
        try {
          if (cfg.freq === 'session') return !!sessionStorage.getItem(cfg.key);
          if (cfg.freq === 'day') {
            var at = parseInt(localStorage.getItem(cfg.key) || '0', 10);
            return !!at && Date.now() - at < 86400000;
          }
        } catch (e) {}
        return false;
      }

      cfg.play = cfg.design || (!reduced() && !seen());

      if (cfg.play) {
        root.classList.add('rakhi-intro-lock');
        // Nothing may keep the page hostage: unlock no matter what goes wrong below.
        setTimeout(function () {
          root.classList.remove('rakhi-intro-lock');
        }, 20000);
      } else {
        root.classList.add('rakhi-intro--skip');
      }

      return cfg;
    })();
  </script>

  <div
    id="RakhiIntro-{{ section.id }}"
    class="rakhi-intro"
    role="dialog"
    aria-label="{{ 'accessibility.loading' | t | escape }}"
  >
    {%- comment -%}
      No width/height attributes: the desktop and mobile files have different
      aspect ratios, so the box is left to the loaded file itself.
    {%- endcomment -%}
    <img class="rakhi-intro__media" alt="">
    {%- if s.allow_skip -%}
      <button type="button" class="rakhi-intro__skip">{{ s.skip_text | escape }}</button>
    {%- endif -%}
  </div>

  <script>
    (function () {
      var cfg = window.rakhiIntro;
      var root = document.documentElement;
      var el = document.getElementById('RakhiIntro-' + cfg.id);
      if (!el) return;

      if (!cfg.play) {
        el.parentNode.removeChild(el);
        return;
      }

      var img = el.querySelector('.rakhi-intro__media');
      var skipBtn = el.querySelector('.rakhi-intro__skip');
      var objectUrl = null;
      var timer = null;
      var finished = false;
      var frozen = false;

      /* An ancestor transform (the theme moves #MainContent when a drawer opens)
         would break position:fixed, so the overlay lives on <body>. */
      document.body.appendChild(el);

      /* Sums the per-frame delays out of the GIF's own blocks, so one full
         play-through is timed from the file rather than guessed at. */
      function gifDuration(buffer) {
        var b = new Uint8Array(buffer);
        if (b.length < 14 || b[0] !== 0x47 || b[1] !== 0x49 || b[2] !== 0x46) return 0;

        var p = 10;
        if (b[p] & 0x80) p += 3 * (1 << ((b[p] & 0x07) + 1));
        p += 3;

        var total = 0;
        var frames = 0;
        var delay = 0;

        while (p < b.length) {
          var block = b[p];

          if (block === 0x21) {
            if (b[p + 1] === 0xf9) {
              delay = b[p + 4] | (b[p + 5] << 8);
              p += 8;
              continue;
            }
            p += 2;
            while (p < b.length && b[p] !== 0) p += b[p] + 1;
            p++;
          } else if (block === 0x2c) {
            var packed = b[p + 9];
            p += 10;
            if (packed & 0x80) p += 3 * (1 << ((packed & 0x07) + 1));
            p++;
            while (p < b.length && b[p] !== 0) p += b[p] + 1;
            p++;

            var ms = delay * 10;
            if (ms < 20) ms = 100; // browsers clamp 0 and 1 centisecond delays
            total += ms;
            frames++;
            delay = 0;
          } else if (block === 0x3b) {
            break;
          } else {
            p++;
          }
        }

        if (!frames || total < 200) return 0;
        return Math.min(total, 30000);
      }

      function looping(b, at) {
        var name = '';
        for (var i = 0; i < 11; i++) name += String.fromCharCode(b[at + i]);
        return name === 'NETSCAPE2.0' || name === 'ANIMEXTS1.0';
      }

      /* Cuts the NETSCAPE2.0 looping block out of the file. Without it the GIF
         plays through exactly once and holds its last frame, instead of
         starting over underneath the fade. */
      function stripLoop(buffer) {
        var b = new Uint8Array(buffer);
        if (b.length < 14 || b[0] !== 0x47 || b[1] !== 0x49 || b[2] !== 0x46) {
          return { bytes: b, stripped: false };
        }

        var p = 10;
        if (b[p] & 0x80) p += 3 * (1 << ((b[p] & 0x07) + 1));
        p += 3;

        /* The looping block always sits ahead of the first frame, so the walk
           stops there; later application blocks (Adobe writes an XMP one at the
           end of both of these files) are left untouched. */
        while (p < b.length && b[p] === 0x21) {
          var label = b[p + 1];
          var end = p + 2;
          while (end < b.length && b[end] !== 0) end += b[end] + 1;
          end++;

          if (label === 0xff && b[p + 2] === 0x0b && looping(b, p + 3)) {
            var out = new Uint8Array(b.length - (end - p));
            out.set(b.subarray(0, p), 0);
            out.set(b.subarray(end), p);
            return { bytes: out, stripped: true };
          }

          p = end;
        }

        return { bytes: b, stripped: false };
      }

      /* Paints the frame that is on screen onto a canvas and swaps it in, so
         nothing can move underneath the fade. */
      function freeze() {
        if (frozen) return;
        try {
          var canvas = document.createElement('canvas');
          canvas.width = img.naturalWidth || img.width;
          canvas.height = img.naturalHeight || img.height;
          if (!canvas.width || !canvas.height) return;
          canvas.getContext('2d').drawImage(img, 0, 0, canvas.width, canvas.height);
          canvas.className = img.className;
          if (img.parentNode) img.parentNode.replaceChild(canvas, img);
          frozen = true;
        } catch (e) {}
      }

      function remember() {
        if (cfg.design) return;
        try {
          if (cfg.freq === 'session') sessionStorage.setItem(cfg.key, '1');
          else if (cfg.freq === 'day') localStorage.setItem(cfg.key, String(Date.now()));
        } catch (e) {}
      }

      function finish(instant) {
        if (finished) return;
        finished = true;
        clearTimeout(timer);
        remember();
        if (!instant) freeze();
        el.classList.add('rakhi-intro--out');

        setTimeout(function () {
          root.classList.remove('rakhi-intro-lock');
          if (el.parentNode) el.parentNode.removeChild(el);
          if (objectUrl) URL.revokeObjectURL(objectUrl);
          document.dispatchEvent(new CustomEvent('rakhi:intro:done'));
        }, cfg.fade + 60);
      }

      /* The play-through is over: pin the final frame first, and only then sit
         on it for the hold. Holding before the freeze is what let a looping
         file get a few frames into its second run before it was covered. */
      function settle() {
        if (finished) return;
        freeze();
        timer = setTimeout(function () {
          finish(true);
        }, cfg.hold);
      }

      function play(src, duration, stops) {
        var run = function () {
          img.classList.add('is-ready');
          if (skipBtn) skipBtn.classList.add('is-ready');

          var ms = duration || cfg.fallback;
          /* If the loop could not be taken out, land a few frames early: a
             timer only ever fires late, and late means the restart is showing. */
          if (!stops && duration) ms = Math.max(200, ms - 80);
          timer = setTimeout(settle, ms);
        };

        img.addEventListener('error', function () {
          finish(true);
        });
        img.addEventListener('load', function () {
          if (img.decode) img.decode().then(run).catch(run);
          else run();
        });
        img.src = src;
      }

      /* Fetching the bytes first gives us the real length, lets us take the
         loop out, and guarantees the animation starts at frame one the moment
         it is shown. */
      if (window.fetch && window.URL && window.URL.createObjectURL) {
        var controller = window.AbortController ? new AbortController() : null;
        var bail = setTimeout(function () {
          if (controller) controller.abort();
        }, 6000);

        fetch(cfg.src, controller ? { signal: controller.signal } : undefined)
          .then(function (res) {
            if (!res.ok) throw new Error('intro gif ' + res.status);
            return res.arrayBuffer();
          })
          .then(function (buffer) {
            clearTimeout(bail);
            var duration = cfg.auto ? gifDuration(buffer) : 0;
            var once = stripLoop(buffer);
            objectUrl = URL.createObjectURL(new Blob([once.bytes], { type: 'image/gif' }));
            play(objectUrl, duration, once.stripped);
          })
          .catch(function () {
            clearTimeout(bail);
            if (!finished) play(cfg.src, 0, false);
          });
      } else {
        play(cfg.src, 0, false);
      }

      if (cfg.skip) {
        el.addEventListener('click', function () {
          finish();
        });
        document.addEventListener('keydown', function (event) {
          if (event.key === 'Escape' || event.key === 'Esc') finish();
        });
      }
    })();
  </script>
{%- endif -%}

{% schema %}
{
  "name": "Rakhi Intro Animation",
  "tag": "div",
  "class": "rakhi-intro-section",
  "settings": [
    {
      "type": "checkbox",
      "id": "enabled",
      "label": "Enable intro animation",
      "default": true
    },
    {
      "type": "header",
      "content": "Animation"
    },
    {
      "type": "paragraph",
      "content": "The GIF is played once at the full width of the screen, edge to edge, centred vertically."
    },
    {
      "type": "image_picker",
      "id": "gif",
      "label": "GIF (desktop)",
      "info": "Upload the animated GIF here, or paste its URL below."
    },
    {
      "type": "text",
      "id": "gif_url",
      "label": "GIF URL (desktop)",
      "default": "https://cdn.shopify.com/s/files/1/0715/1157/2666/files/Rakhi_Desktop.gif?v=1786765970",
      "info": "Paste the file URL from Settings → Files. Takes priority over the GIF above."
    },
    {
      "type": "image_picker",
      "id": "gif_mobile",
      "label": "GIF (mobile)",
      "info": "Shown below 750px. Falls back to the desktop GIF if left empty."
    },
    {
      "type": "text",
      "id": "gif_url_mobile",
      "label": "GIF URL (mobile)",
      "default": "https://cdn.shopify.com/s/files/1/0715/1157/2666/files/Rakhi_Mobile.gif?v=1786765968",
      "info": "Takes priority over the mobile GIF above."
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#0107EF"
    },
    {
      "type": "header",
      "content": "Timing"
    },
    {
      "type": "select",
      "id": "duration_mode",
      "label": "Animation length",
      "options": [
        { "value": "auto", "label": "Detect from the GIF" },
        { "value": "manual", "label": "Set it manually" }
      ],
      "default": "auto",
      "info": "Detection reads the GIF's own frame timings so it fades out after exactly one play."
    },
    {
      "type": "range",
      "id": "duration_ms",
      "min": 500,
      "max": 9500,
      "step": 100,
      "unit": "ms",
      "label": "Manual length",
      "default": 3000,
      "info": "Used when the length is set manually, and as a fallback if detection fails."
    },
    {
      "type": "range",
      "id": "hold_ms",
      "min": 0,
      "max": 3000,
      "step": 100,
      "unit": "ms",
      "label": "Hold on last frame",
      "default": 200
    },
    {
      "type": "range",
      "id": "fade_ms",
      "min": 100,
      "max": 2000,
      "step": 50,
      "unit": "ms",
      "label": "Fade out",
      "default": 700
    },
    {
      "type": "header",
      "content": "Display"
    },
    {
      "type": "select",
      "id": "frequency",
      "label": "Show the intro",
      "options": [
        { "value": "always", "label": "Every page load" },
        { "value": "session", "label": "Once per visit" },
        { "value": "day", "label": "Once a day" }
      ],
      "default": "always",
      "info": "The theme editor always plays it so you can preview your changes."
    },
    {
      "type": "checkbox",
      "id": "allow_skip",
      "label": "Let visitors skip",
      "default": true,
      "info": "Adds a skip button, and dismisses the intro on click or Esc."
    },
    {
      "type": "text",
      "id": "skip_text",
      "label": "Skip button text",
      "default": "Skip"
    },
    {
      "type": "color",
      "id": "skip_color",
      "label": "Skip button color",
      "default": "#FFFFFF"
    }
  ],
  "presets": [
    {
      "name": "Rakhi Intro Animation"
    }
  ]
}
{% endschema %}
