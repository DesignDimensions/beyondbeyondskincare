{% if section.settings.video != blank %}
<section class="youtube-video-section">
  <div class="youtube-video-inner">
    {% if section.settings.heading != blank %}
      <h2 class="youtube-video-heading">
        {{ section.settings.heading }}
      </h2>
    {% endif %}

    <div class="youtube-video-wrapper">
      {{ section.settings.video | video_tag:
        autoplay: false,
        loop: true,
        muted: false,
        controls: true,
        playsinline: true,
        class: 'youtube-video-player',
        image_size: '1920x'
      }}
    </div>
  </div>
</section>

<style>
.youtube-video-section {
  background: #fff;
}

.youtube-video-inner {
  width: 100%;
}

.youtube-video-heading {
  text-align: center;
  margin-bottom: 24px;
  font-size: 24px;
  font-weight: 700;
}

.youtube-video-wrapper {
  position: relative;
  width: 100%;
  margin: 0 auto;
  aspect-ratio: 16 / 9;
  overflow: hidden;
}

.youtube-video-player {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}

@media screen and (max-width: 400px) {
  .youtube-video-wrapper {
    aspect-ratio: 16 / 9;
  }
}
</style>
{% endif %}

{% schema %}
{
  "name": "YouTube Video",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Watch Video"
    },
    {
      "type": "video",
      "id": "video",
      "label": "Video upload"
    }
  ],
  "presets": [
    {
      "name": "YouTube Video"
    }
  ]
}
{% endschema %}
