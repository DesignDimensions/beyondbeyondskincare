{%- liquid
  assign s = section.settings
  assign products_per_row = s.products_per_row
  assign product_collection = s.collection

  # Each block pairs a product with its own gift wrap, so the popup can offer the
  # right wrap (and price) per product rather than one shared gift box.
  assign gift_modal_enabled = false
  if s.enable_gift_modal and section.blocks.size > 0
    assign gift_modal_enabled = true
  endif
-%}

{%- style -%}
    #shopify-section-{{ section.id }} {
      --section-padding-top: {{ s.padding_top }}px;
      --section-padding-bottom: {{ s.padding_bottom }}px;
    }

    #shopify-section-{{ section.id }} .rakhi-grid__header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
      margin-bottom: {{ s.heading_spacing }}px;
    }

    #shopify-section-{{ section.id }} .rakhi-grid__heading {
      margin: 0;
      font-size: {{ s.heading_size }}px;
      font-weight: {{ s.heading_weight }};
      letter-spacing: {{ s.heading_letter_spacing }}px;
      line-height: 1.2;
      {% if s.heading_uppercase %}text-transform: uppercase;{% endif %}
    }

    #shopify-section-{{ section.id }} .rakhi-grid__sort {
      flex: 0 0 auto;
    }

    /* The shared carousel grid hard-codes 64px side padding and auto-fit columns.
       This section sits inside .page-width, so reset both and drive the column
       count from the section settings instead. */
    #shopify-section-{{ section.id }} .shop-products-carousel__grid {
      padding-left: 0;
      padding-right: 0;
      grid-template-columns: repeat({{ products_per_row }}, minmax(0, 1fr));
      column-gap: {{ s.column_gap }}px;
      row-gap: {{ s.row_gap }}px;
    }

    /* Wrapper exists only to carry sort data and be reorderable — it must not
       create a box, or it would become the grid item instead of the card. */
    #shopify-section-{{ section.id }} .rakhi-grid__item {
      display: contents;
    }

    /* The carousel styles pin this to `contain` so 2:3 shots never stretch in a
       fluid column. Overridden here (this section only) so images fill the frame. */
    #shopify-section-{{ section.id }} .bestseller-card__image {
      object-fit: {{ s.image_fit }};
      object-position: {{ s.image_position }};
    }

    #shopify-section-{{ section.id }} .rakhi-grid__empty {
      padding: 40px 0;
      text-align: center;
    }

    @media screen and (max-width: 989px) {
      #shopify-section-{{ section.id }} .shop-products-carousel__grid {
        grid-template-columns: repeat({{ products_per_row | at_most: 3 }}, minmax(0, 1fr));
      }
    }

    @media screen and (max-width: 749px) {
      #shopify-section-{{ section.id }} .shop-products-carousel__grid {
        grid-template-columns: repeat({{ s.columns_mobile }}, minmax(0, 1fr));
        column-gap: {{ s.column_gap_mobile }}px;
        row-gap: {{ s.row_gap_mobile }}px;
      }

      #shopify-section-{{ section.id }} .rakhi-grid__header {
        margin-bottom: {{ s.heading_spacing_mobile }}px;
        {% if s.stack_header_mobile %}
          flex-direction: column;
          align-items: flex-start;
        {% endif %}
      }

      #shopify-section-{{ section.id }} .rakhi-grid__heading {
        font-size: {{ s.heading_size_mobile }}px;
      }
    }

    /* ---------- Gift note popup ---------- */
    #shopify-section-{{ section.id }} .rakhi-gift-modal[hidden] {
      display: none;
    }

    #shopify-section-{{ section.id }} .rakhi-gift-modal {
      position: fixed;
      inset: 0;
      /* The sticky header and drawers in this theme go up to 99999. */
      z-index: 100000;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 20px;
    }

    #shopify-section-{{ section.id }} .rakhi-gift-modal__overlay {
      position: absolute;
      inset: 0;
      background: rgba(0, 0, 0, {{ s.gift_modal_overlay_opacity | divided_by: 100.0 }});
      backdrop-filter: blur({{ s.gift_modal_blur }}px);
      -webkit-backdrop-filter: blur({{ s.gift_modal_blur }}px);
    }

    #shopify-section-{{ section.id }} .rakhi-gift-modal__dialog {
      position: relative;
      background: #ffffff;
      width: 100%;
      max-width: {{ s.gift_modal_width }}px;
      max-height: calc(100vh - 40px);
      overflow-y: auto;
      padding: 26px 30px 30px;
    }

    #shopify-section-{{ section.id }} .rakhi-gift-modal__head {
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      gap: 16px;
    }

    #shopify-section-{{ section.id }} .rakhi-gift-modal__logo {
      display: block;
      width: auto;
      height: 60px;
      max-width: 180px;
      object-fit: contain;
    }

    #shopify-section-{{ section.id }} .rakhi-gift-modal__logo-text {
      font-size: 20px;
      font-weight: 700;
    }

    #shopify-section-{{ section.id }} .rakhi-gift-modal__close {
      background: none;
      border: 0;
      padding: 4px;
      cursor: pointer;
      color: inherit;
      line-height: 0;
    }

    #shopify-section-{{ section.id }} .rakhi-gift-modal__eyebrow {
  margin: 8px 0 0;
      text-align: center;
      text-transform: uppercase;
      letter-spacing: 5px;
      font-size: 16px;
      font-weight: 800;
      color: #202020;  }

    #shopify-section-{{ section.id }} .rakhi-gift-modal__heading {
      margin: 15px 0 33px;
      text-align: center;
      font-size: {{ s.gift_modal_heading_size }}px;
      font-weight: 700;
      line-height: 1.15;
    }

    /* Fixed media column keeps the image from ballooning as the dialog widens. */
    #shopify-section-{{ section.id }} .rakhi-gift-modal__body {
      display: grid;
      grid-template-columns: {{ s.gift_modal_image_width }}px minmax(0, 1fr);
      gap: 28px;
      align-items: start;
    }
    .rakhi-gift-modal__content{
          height: 100%;
    display: flex;
    flex-flow: column;
    justify-content: center;
    }
    #shopify-section-{{ section.id }} .rakhi-gift-modal__media {
          aspect-ratio: 183 / 230;
    }
    #shopify-section-{{ section.id }} .rakhi-gift-modal__media img {
      display: block;
      width: 100%;
      height: 100%;
      object-fit: cover;
      background: #f2f4f7;
    }

    #shopify-section-{{ section.id }} .rakhi-gift-modal__product {
      margin: 0 0 12px;
      font-size: 20px;
      font-weight: 600;
      line-height: 1.2;
    }

    #shopify-section-{{ section.id }} .rakhi-gift-modal__note {
      display: block;
      width: 100%;
      border: 1px solid #d7d7d7;
      border-radius: 12px;
      padding: 14px 16px;
      font-family: inherit;
      font-size: 15px;
      line-height: 1.4;
      resize: vertical;
      min-height: 148px;
    }

    #shopify-section-{{ section.id }} .rakhi-gift-modal__note::placeholder {
      color: #9b9b9b;
    }

    #shopify-section-{{ section.id }} .rakhi-gift-modal__giftbox[hidden] {
      display: none;
    }

    #shopify-section-{{ section.id }} .rakhi-gift-modal__giftbox {
      display: flex;
      align-items: center;
      gap: 10px;
      margin-top: 12px;
      cursor: pointer;
      color: {{ s.gift_box_label_color }};
      font-size: 16px;
      font-weight: 600;
    }

    #shopify-section-{{ section.id }} .rakhi-gift-modal__giftbox input {
      width: 15px;
      height: 15px;
      accent-color: {{ s.gift_box_label_color }};
      cursor: pointer;
      flex: 0 0 auto;
    }

    #shopify-section-{{ section.id }} .rakhi-gift-modal__actions {
      margin-top: 24px;
      text-align: center;
    }

    #shopify-section-{{ section.id }} .rakhi-gift-modal__submit {
      display: block;
      width: 100%;
      background: transparent;
      border: 1px solid #111111;
      padding: 15px 20px;
      font-family: inherit;
      font-size: 15px;
      letter-spacing: 3px;
      text-transform: uppercase;
      cursor: pointer;
    }

    #shopify-section-{{ section.id }} .rakhi-gift-modal__submit[aria-busy='true'] {
      opacity: 0.6;
      pointer-events: none;
    }

    #shopify-section-{{ section.id }} .rakhi-gift-modal__skip {
      display: inline-block;
      margin-top: 14px;
      background: none;
      border: 0;
      padding: 4px;
      font-family: inherit;
      font-size: 14px;
      text-decoration: underline;
      text-underline-offset: 3px;
      cursor: pointer;
      color: inherit;
    }

    #shopify-section-{{ section.id }} .rakhi-gift-modal__error {
      margin: 14px 0 0;
      text-align: center;
      color: #d02c2c;
    }

    #shopify-section-{{ section.id }} .rakhi-gift-modal__error[hidden] {
      display: none;
    }

    @media screen and (max-width: 749px) {
      #shopify-section-{{ section.id }} .rakhi-gift-modal__dialog {
        padding: 20px 20px 24px;
      }

      #shopify-section-{{ section.id }} .rakhi-gift-modal__eyebrow {
        letter-spacing: 3px;
        font-size: 12px;
      }

      #shopify-section-{{ section.id }} .rakhi-gift-modal__heading {
        font-size: {{ s.gift_modal_heading_size_mobile }}px;
        margin-bottom: 20px;
      }

      #shopify-section-{{ section.id }} .rakhi-gift-modal__body {
        grid-template-columns: minmax(0, 1fr);
        gap: 18px;
      }

      #shopify-section-{{ section.id }} .rakhi-gift-modal__media img {
        max-width: {{ s.gift_modal_image_width }}px;
        margin: 0 auto;
      }

      #shopify-section-{{ section.id }} .rakhi-gift-modal__product {
        font-size: 19px;
      }

      #shopify-section-{{ section.id }} .rakhi-gift-modal__giftbox {
        font-size: 16px;
      }
    }
{%- endstyle -%}

{%- if s.show_sorting -%}
  {{ 'component-facets.css' | asset_url | stylesheet_tag }}
{%- endif -%}

<div class="rakhi-grid section--padding">
  <div class="page-width">
    {%- if s.heading != blank or s.show_sorting -%}
      <div class="rakhi-grid__header">
        {%- if s.heading != blank -%}
          <{{ s.heading_tag }} class="rakhi-grid__heading">{{ s.heading }}</{{ s.heading_tag }}>
        {%- else -%}
          <span></span>
        {%- endif -%}

        {%- if s.show_sorting -%}
          {%- comment -%}
            Same markup as the collection page sort control in snippets/facets.liquid.
            Options come from the collection so the labels match, minus the ones that
            need server data (best selling, relevance) — this sorts in the browser.
          {%- endcomment -%}
          {%- assign supported_sorts = 'manual,title-ascending,title-descending,price-ascending,price-descending,created-ascending,created-descending'
            | split: ','
          -%}
          <div class="sorting rakhi-grid__sort">
            <div class="facet-filters__field">
              <details class="disclosure-has-popup facets__disclosure facet-filters__sort" data-rakhi-sort>
                <summary class="facets__summary">
                  <span class="button button--secondary button--small">
                    {{- 'products.facets.sort_by_label' | t -}}
                    {%- render 'icon', icon: 'caret' -%}
                  </span>
                </summary>
                <div class="facets__display">
                  <ul class="facets__list list-unstyled" role="list">
                    {%- for option in product_collection.sort_options -%}
                      {%- if supported_sorts contains option.value -%}
                        <li class="list-menu__item facets__item">
                          <label for="RakhiSort-{{ section.id }}-{{ option.value | escape }}" class="facet-checkbox">
                            <input
                              type="radio"
                              name="rakhi_sort_by_{{ section.id }}"
                              value="{{ option.value | escape }}"
                              id="RakhiSort-{{ section.id }}-{{ option.value | escape }}"
                              {% if option.value == 'manual' %}
                                checked="checked"
                              {% endif %}
                              class="visually-hidden"
                            >
                            <span class="label">{{ option.name | escape }}</span>
                          </label>
                        </li>
                      {%- endif -%}
                    {%- endfor -%}
                  </ul>
                </div>
              </details>
            </div>
          </div>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if product_collection == blank -%}
      <div class="rakhi-grid__empty">
        <p>Select a collection in the section settings to show products here.</p>
      </div>
    {%- elsif product_collection.products.size == 0 -%}
      <div class="rakhi-grid__empty">
        <p>{{ 'sections.collection_template.no_products' | t }}</p>
      </div>
    {%- else -%}
      <div class="shop-products-carousel__grid" data-rakhi-grid>
        {%- for product in product_collection.products limit: s.products_to_show -%}
          {%- liquid
            # Sub-title under the product name: prefer the product's own Concerns
            # metafield so each card reads differently, fall back to the section text.
            assign card_skin_text = s.skin_text
            if s.use_concerns_metafield
              assign product_concerns = product.metafields.custom.concerns.value
              if product_concerns != blank
                assign card_skin_text = product_concerns | join: ', '
              endif
            endif

            assign opens_gift_modal = false
            assign card_gift_variant = blank
            assign card_gift_price = blank
            if gift_modal_enabled
              for gift_block in section.blocks
                if gift_block.settings.product != blank and gift_block.settings.product.handle == product.handle
                  assign opens_gift_modal = true
                  assign block_gift_variant = gift_block.settings.gift_box_product.selected_or_first_available_variant
                  if block_gift_variant != blank
                    assign card_gift_variant = block_gift_variant.id
                    assign card_gift_price = block_gift_variant.price | money
                  endif
                  break
                endif
              endfor
            endif
          -%}
          <div
            class="rakhi-grid__item"
            {% if opens_gift_modal %}
              data-gift-modal-trigger
              data-gift-product-title="{{ product.title | escape }}"
              data-gift-product-image="{{ product.featured_image | image_url: width: 800 }}"
              data-gift-product-image-alt="{{ product.featured_image.alt | default: product.title | escape }}"
              {% if card_gift_variant != blank %}
                data-gift-box-variant="{{ card_gift_variant }}"
                data-gift-box-price="{{ card_gift_price }}"
              {% endif %}
            {% endif %}
            data-sort-position="{{ forloop.index }}"
            data-sort-price="{{ product.price | default: 0 }}"
            data-sort-title="{{ product.title | strip_html | escape | downcase }}"
            data-sort-date="{{ product.created_at | date: '%s' }}"
          >
            {% render 'bestseller-card',
              product: product,
              card_label: s.card_label,
              show_add_to_cart: s.show_add_to_cart,
              show_rating: s.show_rating,
              skin_text: card_skin_text,
              size_source: s.size_source
            %}
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</div>

{%- if gift_modal_enabled -%}
  {%- assign modal_logo = s.gift_modal_logo | default: settings.logo -%}
  <div class="rakhi-gift-modal" data-gift-modal hidden>
    <div class="rakhi-gift-modal__overlay" data-gift-modal-close>.</div>
    <div
      class="rakhi-gift-modal__dialog"
      role="dialog"
      aria-modal="true"
      aria-labelledby="GiftModalHeading-{{ section.id }}"
    >
      <div class="rakhi-gift-modal__head">
        {%- if modal_logo != blank -%}
          <img
            class="rakhi-gift-modal__logo"
            src="{{ modal_logo | image_url: width: 300 }}"
            alt="{{ shop.name | escape }}"
            width="{{ modal_logo.width }}"
            height="{{ modal_logo.height }}"
            loading="lazy"
          >
        {%- else -%}
          <span class="rakhi-gift-modal__logo-text">{{ shop.name }}</span>
        {%- endif -%}

        <button
          type="button"
          class="rakhi-gift-modal__close"
          data-gift-modal-close
          aria-label="{{ 'accessibility.close' | t }}"
        >
          <svg viewBox="0 0 24 24" width="28" height="28" aria-hidden="true" focusable="false">
            <path d="M4 4 L20 20 M20 4 L4 20" stroke="currentColor" stroke-width="1.5" fill="none"/>
          </svg>
        </button>
      </div>

      {%- if s.gift_modal_eyebrow != blank -%}
        <p class="rakhi-gift-modal__eyebrow">{{ s.gift_modal_eyebrow }}</p>
      {%- endif -%}
      <h2 class="rakhi-gift-modal__heading" id="GiftModalHeading-{{ section.id }}">{{ s.gift_modal_heading }}</h2>

      <div class="rakhi-gift-modal__body">
        <div class="rakhi-gift-modal__media">
          {%- comment -%} src/alt are filled in by JS from the clicked card. {%- endcomment -%}
          <img data-gift-modal-image src="" alt="" width="800" height="800" loading="lazy">
        </div>

        <div class="rakhi-gift-modal__content">
          <p class="rakhi-gift-modal__product" data-gift-modal-title></p>

          <label class="visually-hidden" for="GiftNote-{{ section.id }}">{{ s.gift_modal_heading }}</label>
          <textarea
            id="GiftNote-{{ section.id }}"
            class="rakhi-gift-modal__note"
            data-gift-modal-note
            rows="5"
            maxlength="{{ s.gift_note_max }}"
            placeholder="{{ s.gift_modal_placeholder | escape }}"
          ></textarea>

          <label class="rakhi-gift-modal__giftbox" data-gift-modal-giftbox-wrap hidden>
            <input type="checkbox" data-gift-modal-giftbox value="">
            <span data-gift-modal-giftbox-label>{{ s.gift_box_label }}</span>
          </label>
        </div>
      </div>

      <div class="rakhi-gift-modal__actions">
        <button type="button" class="rakhi-gift-modal__submit" data-gift-modal-submit>{{ s.gift_modal_button }}</button>
        <button type="button" class="rakhi-gift-modal__skip" data-gift-modal-skip>{{ s.gift_modal_skip }}</button>
      </div>

      <p class="rakhi-gift-modal__error" data-gift-modal-error hidden role="alert"></p>
    </div>
  </div>
{%- endif -%}

<script>
  (() => {
    // Resolve by section id rather than previousElementSibling: this script has more
    // than one sibling (grid + popup), so a positional lookup silently picks the wrong one.
    const scope = document.getElementById('shopify-section-{{ section.id }}');
    if (!scope || scope.dataset.rakhiGridInit === '1') return;
    scope.dataset.rakhiGridInit = '1';

    // --- Card image slider (same behaviour as the Shop Products carousel) ---
    scope.querySelectorAll('[data-bestseller-card]').forEach((card) => {
      const slides = Array.from(card.querySelectorAll('[data-bestseller-slide]'));
      const dotsWrap = card.querySelector('[data-bestseller-dots]');
      const prev = card.querySelector('[data-bestseller-prev]');
      const next = card.querySelector('[data-bestseller-next]');

      if (!slides.length) return;

      let idx = 0;
      const setSlide = (n) => {
        idx = (n + slides.length) % slides.length;
        slides.forEach((s, i) => s.classList.toggle('is-active', i === idx));
        if (dotsWrap) {
          dotsWrap.querySelectorAll('button').forEach((d, i) => d.classList.toggle('is-active', i === idx));
        }
      };

      if (dotsWrap) {
        dotsWrap.innerHTML = slides.map((_, i) => `<button type="button" class="${i === 0 ? 'is-active' : ''}" aria-label="Slide ${i + 1}"></button>`).join('');
        dotsWrap.querySelectorAll('button').forEach((dot, i) => dot.addEventListener('click', () => setSlide(i)));
      }

      if (slides.length < 2) {
        if (prev) prev.style.display = 'none';
        if (next) next.style.display = 'none';
      } else {
        prev && prev.addEventListener('click', (e) => { e.preventDefault(); setSlide(idx - 1); });
        next && next.addEventListener('click', (e) => { e.preventDefault(); setSlide(idx + 1); });
      }

      setSlide(0);
    });

    // --- Gift note popup ---
    const modal = scope.querySelector('[data-gift-modal]');
    const modalGrid = scope.querySelector('[data-rakhi-grid]');

    if (modal && modalGrid) {
      const imageEl = modal.querySelector('[data-gift-modal-image]');
      const titleEl = modal.querySelector('[data-gift-modal-title]');
      const noteEl = modal.querySelector('[data-gift-modal-note]');
      const giftBoxEl = modal.querySelector('[data-gift-modal-giftbox]');
      const giftBoxWrap = modal.querySelector('[data-gift-modal-giftbox-wrap]');
      const giftBoxLabel = modal.querySelector('[data-gift-modal-giftbox-label]');
      const giftBoxLabelText = {{ s.gift_box_label | json }};
      const submitEl = modal.querySelector('[data-gift-modal-submit]');
      const skipEl = modal.querySelector('[data-gift-modal-skip]');
      const errorEl = modal.querySelector('[data-gift-modal-error]');
      const notePropertyName = {{ s.gift_note_property | json }};

      let activeVariantId = null;
      let lastFocused = null;
      let previousOverflow = '';

      const showError = (message) => {
        if (!errorEl) return;
        errorEl.textContent = message;
        errorEl.hidden = !message;
      };

      const openModal = (item, variantId) => {
        activeVariantId = variantId;
        showError('');

        if (titleEl) titleEl.textContent = item.dataset.giftProductTitle || '';
        if (imageEl) {
          imageEl.src = item.dataset.giftProductImage || '';
          imageEl.alt = item.dataset.giftProductImageAlt || '';
        }
        if (noteEl) noteEl.value = '';

        // Each product carries its own gift wrap, so the checkbox is rebuilt per open
        // and stays hidden for products without one.
        const giftVariant = item.dataset.giftBoxVariant || '';
        const giftPrice = item.dataset.giftBoxPrice || '';
        if (giftBoxEl) {
          giftBoxEl.checked = false;
          giftBoxEl.value = giftVariant;
        }
        if (giftBoxLabel) {
          giftBoxLabel.textContent = giftPrice ? `${giftBoxLabelText} ${giftPrice}` : giftBoxLabelText;
        }
        if (giftBoxWrap) giftBoxWrap.hidden = !giftVariant;

        lastFocused = document.activeElement;
        modal.hidden = false;
        previousOverflow = document.body.style.overflow;
        document.body.style.overflow = 'hidden';
        if (noteEl) noteEl.focus();
      };

      const closeModal = () => {
        modal.hidden = true;
        activeVariantId = null;
        document.body.style.overflow = previousOverflow;
        if (lastFocused && typeof lastFocused.focus === 'function') lastFocused.focus();
      };

      const addToCart = (includeExtras) => {
        if (!activeVariantId) return;

        const miniCart = document.querySelector('mini-cart');
        const sections = miniCart ? miniCart.getSectionsToRender().map((section) => section.id) : [];

        const line = { id: activeVariantId, quantity: 1 };
        if (includeExtras) {
          const note = ((noteEl && noteEl.value) || '').trim();
          if (note) line.properties = { [notePropertyName]: note };
        }

        const items = [line];
        // Skipping must never add the gift box, even if it was ticked first.
        if (includeExtras && giftBoxEl && giftBoxEl.checked && giftBoxEl.value) {
          // Underscore prefix hides it from the customer-facing property list, and lets the
          // cart cap the wrap's quantity against the product it belongs to.
          items.push({
            id: giftBoxEl.value,
            quantity: 1,
            properties: { _gift_wrap_for: String(activeVariantId) },
          });
        }

        const addUrl = (window.theme && theme.routes && theme.routes.cart_add_url) || '/cart/add';
        const body = JSON.stringify({ items, sections, sections_url: window.location.pathname });
        const config = typeof fetchConfig === 'function'
          ? { ...fetchConfig('javascript'), body }
          : { method: 'POST', headers: { 'Content-Type': 'application/json', Accept: 'application/json' }, body };

        submitEl.setAttribute('aria-busy', 'true');
        showError('');

        fetch(addUrl, config)
          .then((response) => response.json())
          .then((state) => {
            if (state.status === 422 || state.status === 404 || state.status === 400) {
              showError(state.description || state.message || 'This item could not be added to your cart.');
              return;
            }
            closeModal();
            if (miniCart) miniCart.renderContents(state);
            document.dispatchEvent(new CustomEvent('ajaxProduct:added', { detail: { product: state } }));
          })
          .catch(() => showError('Something went wrong. Please try again.'))
          .finally(() => submitEl.removeAttribute('aria-busy'));
      };

      // Capture phase so this runs before <add-to-cart>'s own click handler,
      // which is bound directly on the element and would otherwise add straight away.
      modalGrid.addEventListener('click', (event) => {
        const item = event.target.closest('[data-gift-modal-trigger]');
        if (!item) return;
        const trigger = event.target.closest('add-to-cart[data-variant-id]');
        if (!trigger) return;

        event.preventDefault();
        event.stopPropagation();
        openModal(item, trigger.dataset.variantId);
      }, true);

      modal.querySelectorAll('[data-gift-modal-close]').forEach((el) => {
        el.addEventListener('click', closeModal);
      });
      submitEl && submitEl.addEventListener('click', () => addToCart(true));
      skipEl && skipEl.addEventListener('click', () => addToCart(false));

      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape' && !modal.hidden) closeModal();
      });
    }

    // --- Sorting ---
    const sortEl = scope.querySelector('[data-rakhi-sort]');
    const grid = scope.querySelector('[data-rakhi-grid]');
    if (!sortEl || !grid) return;

    const num = (el, attr) => Number(el.getAttribute(attr)) || 0;
    const str = (el, attr) => el.getAttribute(attr) || '';

    // Keys match Shopify's own sort_by values so the labels and behaviour line up
    // with the collection page.
    const comparators = {
      manual: (a, b) => num(a, 'data-sort-position') - num(b, 'data-sort-position'),
      'price-ascending': (a, b) => num(a, 'data-sort-price') - num(b, 'data-sort-price'),
      'price-descending': (a, b) => num(b, 'data-sort-price') - num(a, 'data-sort-price'),
      'title-ascending': (a, b) => str(a, 'data-sort-title').localeCompare(str(b, 'data-sort-title')),
      'title-descending': (a, b) => str(b, 'data-sort-title').localeCompare(str(a, 'data-sort-title')),
      'created-ascending': (a, b) => num(a, 'data-sort-date') - num(b, 'data-sort-date'),
      'created-descending': (a, b) => num(b, 'data-sort-date') - num(a, 'data-sort-date'),
    };

    sortEl.addEventListener('change', (event) => {
      const input = event.target;
      if (!input || input.name.indexOf('rakhi_sort_by_') !== 0) return;

      const compare = comparators[input.value] || comparators.manual;
      const items = Array.from(grid.children);
      items.sort(compare);
      const fragment = document.createDocumentFragment();
      items.forEach((item) => fragment.appendChild(item));
      grid.appendChild(fragment);

      // Match the collection page: picking an option closes the disclosure.
      sortEl.open = false;
    });
  })();
</script>

