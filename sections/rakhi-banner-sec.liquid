{%- liquid
  assign s = section.settings
-%}

{%- style -%}
  #shopify-section-{{ section.id }} {
    --rakhi-banner-bg: {{ s.background_color }};
    --rakhi-banner-text: {{ s.text_color }};
    --rakhi-banner-pt: {{ s.padding_top }}px;
    --rakhi-banner-pb: {{ s.padding_bottom }}px;
    --rakhi-banner-min-h: {{ s.min_height }}px;
    --rakhi-banner-min-h-mobile: {{ s.min_height_mobile }}px;
    --rakhi-banner-heading-size: {{ s.heading_size }}px;
    --rakhi-banner-heading-size-mobile: {{ s.heading_size_mobile }}px;
    --rakhi-banner-heading-weight: {{ s.heading_weight }};
    --rakhi-banner-heading-spacing: {{ s.heading_letter_spacing }}px;
    --rakhi-banner-subtext-size: {{ s.subtext_size }}px;
    --rakhi-banner-subtext-size-mobile: {{ s.subtext_size_mobile }}px;
  }

  #shopify-section-{{ section.id }} .rakhi-banner {
    position: relative;
    background-color: var(--rakhi-banner-bg);
    color: var(--rakhi-banner-text);
    padding-top: var(--rakhi-banner-pt);
    padding-bottom: var(--rakhi-banner-pb);
    min-height: var(--rakhi-banner-min-h);
    display: flex;
    flex-direction: column;
    justify-content: center;
    overflow: hidden;
  }

  #shopify-section-{{ section.id }} .rakhi-banner__bg-image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: {{ s.image_position }};
    z-index: 0;
  }

  #shopify-section-{{ section.id }} .rakhi-banner__overlay {
    position: absolute;
    inset: 0;
    background-color: {{ s.background_color }};
    opacity: {{ s.overlay_opacity | divided_by: 100.0 }};
    z-index: 1;
  }

  #shopify-section-{{ section.id }} .rakhi-banner__inner {
    position: relative;
    z-index: 2;
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: {{ s.gap }}px;
  }

  #shopify-section-{{ section.id }} .rakhi-banner__heading {
    margin: 0;
    color: var(--rakhi-banner-text);
    font-size: var(--rakhi-banner-heading-size);
    font-weight: var(--rakhi-banner-heading-weight);
    letter-spacing: var(--rakhi-banner-heading-spacing);
    line-height: 1.1;
    text-align: {{ s.heading_alignment }};
  }

  #shopify-section-{{ section.id }} .rakhi-banner__subtext {
    color: var(--rakhi-banner-text);
    font-size: var(--rakhi-banner-subtext-size);
    line-height: 1.3;
    text-align: {{ s.subtext_alignment }};
  }

  #shopify-section-{{ section.id }} .rakhi-banner__subtext strong,
  #shopify-section-{{ section.id }} .rakhi-banner__subtext b {
    font-weight: 700;
  }

  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} .rakhi-banner {
      min-height: var(--rakhi-banner-min-h-mobile);
    }

    #shopify-section-{{ section.id }} .rakhi-banner__heading {
      font-size: var(--rakhi-banner-heading-size-mobile);
      text-align: {{ s.heading_alignment_mobile }};
    }

    #shopify-section-{{ section.id }} .rakhi-banner__subtext {
      font-size: var(--rakhi-banner-subtext-size-mobile);
      text-align: {{ s.subtext_alignment_mobile }};
    }
  }
{%- endstyle -%}

<div class="rakhi-banner">
  {%- if s.background_image != blank -%}
    {{
      s.background_image
      | image_url: width: 3000
      | image_tag:
        loading: 'eager',
        fetchpriority: 'high',
        class: 'rakhi-banner__bg-image',
        sizes: '100vw',
        widths: '750, 1100, 1500, 1780, 2000, 3000',
        alt: s.background_image.alt | default: s.heading | strip_html
    }}
    <div class="rakhi-banner__overlay"></div>
  {%- endif -%}

  <div class="rakhi-banner__inner{% unless s.full_width %} page-width{% endunless %}">
    {%- if s.heading != blank -%}
      <{{ s.heading_tag }} class="rakhi-banner__heading">{{ s.heading }}</{{ s.heading_tag }}>
    {%- endif -%}

    {%- if s.subtext != blank -%}
      <div class="rakhi-banner__subtext">{{ s.subtext }}</div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Rakhi Banner",
  "tag": "section",
  "class": "section rakhi-banner-section",
  "settings": [
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Love, Care & Protection"
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "Heading HTML tag",
      "info": "Use h1 only if this is the main heading of the page.",
      "options": [
        { "value": "h1", "label": "h1" },
        { "value": "h2", "label": "h2" },
        { "value": "h3", "label": "h3" },
        { "value": "div", "label": "div" }
      ],
      "default": "h2"
    },
    {
      "type": "inline_richtext",
      "id": "subtext",
      "label": "Sub text",
      "info": "Select text and use the bold button to emphasise part of it, e.g. NAD+.",
      "default": "- Powered By <strong>NAD+</strong>"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#0a0af0"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Background image",
      "info": "Optional. Leave empty to use a solid background color."
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background image"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image position",
      "options": [
        { "value": "top left", "label": "Top left" },
        { "value": "top center", "label": "Top center" },
        { "value": "top right", "label": "Top right" },
        { "value": "center left", "label": "Middle left" },
        { "value": "center center", "label": "Middle center" },
        { "value": "center right", "label": "Middle right" },
        { "value": "bottom left", "label": "Bottom left" },
        { "value": "bottom center", "label": "Bottom center" },
        { "value": "bottom right", "label": "Bottom right" }
      ],
      "default": "center center"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "label": "Background color overlay opacity",
      "info": "Only applies when a background image is set.",
      "default": 0
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "Make text full width",
      "default": false
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "Heading alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "subtext_alignment",
      "label": "Sub text alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "right"
    },
    {
      "type": "range",
      "id": "gap",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "label": "Space between heading and sub text",
      "default": 24
    },
    {
      "type": "range",
      "id": "min_height",
      "min": 100,
      "max": 700,
      "step": 10,
      "unit": "px",
      "label": "Minimum height (desktop)",
      "default": 220
    },
    {
      "type": "range",
      "id": "min_height_mobile",
      "min": 100,
      "max": 500,
      "step": 10,
      "unit": "px",
      "label": "Minimum height (mobile)",
      "default": 160
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "heading_size",
      "min": 20,
      "max": 120,
      "step": 2,
      "unit": "px",
      "label": "Heading size (desktop)",
      "default": 64
    },
    {
      "type": "range",
      "id": "heading_size_mobile",
      "min": 16,
      "max": 64,
      "step": 1,
      "unit": "px",
      "label": "Heading size (mobile)",
      "default": 28
    },
    {
      "type": "select",
      "id": "heading_weight",
      "label": "Heading weight",
      "options": [
        { "value": "300", "label": "Light" },
        { "value": "400", "label": "Regular" },
        { "value": "500", "label": "Medium" },
        { "value": "600", "label": "Semi bold" },
        { "value": "700", "label": "Bold" }
      ],
      "default": "300"
    },
    {
      "type": "range",
      "id": "heading_letter_spacing",
      "min": -2,
      "max": 10,
      "step": 1,
      "unit": "px",
      "label": "Heading letter spacing",
      "default": 0
    },
    {
      "type": "range",
      "id": "subtext_size",
      "min": 10,
      "max": 48,
      "step": 1,
      "unit": "px",
      "label": "Sub text size (desktop)",
      "default": 22
    },
    {
      "type": "range",
      "id": "subtext_size_mobile",
      "min": 10,
      "max": 32,
      "step": 1,
      "unit": "px",
      "label": "Sub text size (mobile)",
      "default": 14
    },
    {
      "type": "header",
      "content": "Mobile alignment"
    },
    {
      "type": "select",
      "id": "heading_alignment_mobile",
      "label": "Heading alignment (mobile)",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "subtext_alignment_mobile",
      "label": "Sub text alignment (mobile)",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "right"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 48
    }
  ],
  "presets": [
    {
      "name": "Rakhi Banner"
    }
  ]
}
{% endschema %}
