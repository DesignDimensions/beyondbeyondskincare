{%- style -%}
  #shopify-section-{{ section.id }} {
    --gradient-background: {% if section.settings.gradient_background != blank %}{{ section.settings.gradient_background }}{% else %}{{ section.settings.colors_background }}{% endif %};
    --color-background: {{ section.settings.colors_background.red }}, {{ section.settings.colors_background.green }}, {{ section.settings.colors_background.blue }};
    --color-foreground: {{ section.settings.colors_text.red }}, {{ section.settings.colors_text.green }}, {{ section.settings.colors_text.blue }};
    --color-link: {{ section.settings.colors_link.red }}, {{ section.settings.colors_link.green }}, {{ section.settings.colors_link.blue }};
    --color-border: {{ section.settings.colors_border.red }}, {{ section.settings.colors_border.green }}, {{ section.settings.colors_border.blue }};
    --color-heading: {{ section.settings.colors_heading.red }}, {{ section.settings.colors_heading.green }}, {{ section.settings.colors_heading.blue }};
    --color-highlight: {{ section.settings.colors_highlight.red }}, {{ section.settings.colors_highlight.green }}, {{ section.settings.colors_highlight.blue }};
  }
{%- endstyle -%}

{{ 'section-footer.css' | asset_url | stylesheet_tag }}

<link rel="stylesheet" href="{{ 'component-newsletter.css' | asset_url }}" media="print" onload="this.media='all'">
<link rel="stylesheet" href="{{ 'component-accordion.css' | asset_url }}" media="print" onload="this.media='all'">
<link rel="stylesheet" href="{{ 'component-list-payment.css' | asset_url }}" media="print" onload="this.media='all'">
<link rel="stylesheet" href="{{ 'component-list-social.css' | asset_url }}" media="print" onload="this.media='all'">
<link rel="stylesheet" href="{{ 'component-rte.css' | asset_url }}" media="print" onload="this.media='all'">

<noscript>{{ 'component-newsletter.css' | asset_url | stylesheet_tag }}</noscript>
<noscript>{{ 'component-accordion.css' | asset_url | stylesheet_tag }}</noscript>
<noscript>{{ 'component-list-payment.css' | asset_url | stylesheet_tag }}</noscript>
<noscript>{{ 'component-list-social.css' | asset_url | stylesheet_tag }}</noscript>
<noscript>{{ 'component-rte.css' | asset_url | stylesheet_tag }}</noscript>

<script src="{{ 'footer-accordion.js' | asset_url }}" defer="defer"></script>

<footer class="footer{% if section.settings.show_divider %} footer--border-top{% endif %}">
  {%- liquid
    assign enable_right_column = false
    if section.settings.newsletter_enable or section.settings.show_social or section.settings.enable_follow_on_shop
      assign enable_right_column = true
    endif
  -%}
  {%- if section.blocks.size > 0 or enable_right_column -%}
    <div class="footer__content-top page-width">
      <div class="grid">
        {%- if section.blocks.size > 0 -%}
          <div class="grid__item footer__content-left{% if section.blocks.size >= 3 and enable_right_column %} footer__content-left--alt{% endif %}{% if section.blocks.size == 1 and enable_right_column == false %} footer__content-left--only{% endif %}">
            <div class="footer__blocks-wrapper grid grid--1-col grid--2-col grid--4-col-tablet">
              <div class="left__d footer__block_item">
                {%- for block in section.blocks -%}
                  {%- case block.type -%}
                   {%- when 'image' -%}
                      <div class="footer-block__details-content footer-block-image {{ block.settings.alignment }}">
                        {%- if block.settings.link != blank -%}
                          <a href="{{ block.settings.link }}">
                        {%- endif -%}
                          {%- if block.settings.image != blank -%}
                            {%- liquid
                              assign image_width = block.settings.image_width
                              assign image_width_2x = block.settings.image_width | times: 2
                            -%}
                            <img
                              srcset= "{{ block.settings.image | image_url: width: image_width }}, {{ block.settings.image | image_url: width: image_width_2x }} 2x"
                              src="{{ block.settings.image | image_url: width: image_width }}"
                              alt="{{ block.settings.image.alt | escape }}"
                              loading="lazy"
                              width="{{ block.settings.image.width }}"
                              height="{{ block.settings.image.height }}"
                              style="max-width: min(100%, {{ image_width }}px);"
                            />
                          {%- else -%}
                            {{ 'image' | placeholder_svg_tag: 'placeholder' }}
                          {%- endif -%}
                        {%- if block.settings.link != blank -%}
                          </a>
                        {%- endif -%}
                        <p class="caption-large">
                          {%- render 'highlight-text', 
                            hl_input: block.settings.text, 
                            hl_style: block.settings.highlight_style,
                            hl_enable: block.settings.enable_highlight,
                            hl_animateWrap: true -%}
                        </p>

                        {% comment %} Newsletter code start {% endcomment %}
                        <div class="newsletter_f_sec">
                          {% if section.settings.newsletter_heading != blank %}
                          <h4>{{section.settings.newsletter_heading }}</h4>
                          {% endif %}
                          <div class="footer-block__details-content">
                            <div class="footer-block__newsletter">
                              {%- assign return_url = section.settings.return_url | default: 'back' | append: '' -%}
                              {%- form 'customer', id: 'ContactFooter', class: 'footer__newsletter newsletter-form', return_to: return_url -%}
                                <input type="hidden" name="contact[tags]" value="newsletter"/>

                                <div class="field">
                                  <input
                                    id="ContactFooter-email"
                                    type="email"
                                    name="contact[email]"
                                    class="field__input required{% if form.errors %} invalid{% endif %}"
                                    value="{{ form.email }}"
                                    aria-required="true"
                                    autocorrect="off"
                                    autocapitalize="off"
                                    autocomplete="email"
                                    {% if form.errors %}
                                      autofocus
                                      aria-invalid="true"
                                      aria-describedby="ContactFooter-error"
                                    {% elsif form.posted_successfully? %}
                                      aria-describedby="ContactFooter-success"
                                    {% endif %}
                                    placeholder="Enter email id"
                                    required
                                  />
                                  <label class="visually-hidden" for="ContactFooter-email">{{ 'newsletter.label' | t }}</label>
                                  <button type="submit" class="button button--arrow field__button animate-arrow" name="commit" aria-label="{{ 'newsletter.button_label' | t }}">
                                    {% comment %} {% render 'icon', icon: 'arrow' %} {% endcomment %}
                                    <svg width="13" height="10" viewBox="0 0 13 10" fill="none" xmlns="http://www.w3.org/2000/svg">
                                    <path d="M7.71967 1.28033C7.42678 0.987437 7.42678 0.512563 7.71967 0.21967C8.01256 -0.0732233 8.48744 -0.0732233 8.78033 0.21967L12.7803 4.21967C13.0732 4.51256 13.0732 4.98744 12.7803 5.28033L8.78033 9.28033C8.48744 9.57322 8.01256 9.57322 7.71967 9.28033C7.42678 8.98744 7.42678 8.51256 7.71967 8.21967L10.4393 5.5H0.75C0.335787 5.5 0 5.16421 0 4.75C0 4.33579 0.335787 4 0.75 4H10.4393L7.71967 1.28033Z" fill="black"/>
                                    </svg>
                                  </button>
                                </div>
                                {%- if form.errors -%}
                                  <small class="form__message errors" id="ContactFooter-error">
                                    {% render 'icon', icon: 'error' %}
                                    {{ form.errors.translated_fields['email'] | capitalize }} {{ form.errors.messages['email'] }}
                                  </small>
                                {%- endif -%}
                                
                                <div class="typeset rte">
                                  {%- render 'highlight-text', 
                                    hl_input: section.settings.newsletter_text, 
                                    hl_style: section.settings.highlight_style,
                                    hl_enable: section.settings.enable_highlight,
                                    hl_animateWrap: true -%}
                                </div>

                                {%- if form.posted_successfully? -%}
                                  <p class="form__message h3" id="ContactFooter-success" tabindex="-1" autofocus>
                                    {% render 'icon', icon: 'success' %}
                                    {{ 'newsletter.success' | t }}
                                  </p>
                                {%- endif -%}
                                
                              {%- endform -%}
                            </div>
                          </div>
                        </div>
                        {% comment %} Newsletter code end {% endcomment %}

                        <div class="f_follow_us">
                          <div class="f_follow_us_title">FOLLOW US</div>
                          <ul class="footer__list-social list-unstyled list-social" role="list">
                            {% render 'social-icons' %}
                            <li class="list-social__item--placeholder">{{ 'sections.footer.social_placeholder' | t }}</li>
                          </ul>
                        </div>

                      </div>
                    {%- endcase-%}
                {%- endfor -%}
              </div>
              <div class="middle__d footer__block_item">
                {%- for block in section.blocks -%}
                  {%- case block.type -%}
                    {%- when 'shop_link_list' -%}
                       <div class="h4 title_h4 mobile_title_h4"><a href="{{ block.setting.mobile_heading_link }}">Shop All</a></div>
                      <div class="footer___item">
                        
                      <div class="h4 title_h4">
                        {%- render 'highlight-text', 
                          hl_input: block.settings.heading, 
                          hl_style: block.settings.highlight_style,
                          hl_enable: block.settings.enable_highlight,
                          hl_animateWrap: true -%}
                        </div>
                        {%- if block.settings.menu != blank -%}
                          <ul class="footer-block__details-content list-unstyled">
                            {%- for link in block.settings.menu.links -%}
                              <li>
                                <a href="{{ link.url }}" class="link list-menu__item list-menu__item--link{% if link.active %} list-menu__item--active{% endif %}">
                                  {{ link.title }}
                                </a>
                              </li>
                            {%- endfor -%}
                          </ul>
                        {%- endif -%}
                      </div>
                  {%- endcase-%}
                {%- endfor -%}
              </div>
              <div class="right__d footer__block_item">
                {%- for block in section.blocks -%}
                  {%- case block.type -%}
                 {%- when 'link_list' -%}
                  <div class="footer___item">
                  <div class="h4 title_h4">
                        {%- render 'highlight-text', 
                          hl_input: block.settings.heading, 
                          hl_style: block.settings.highlight_style,
                          hl_enable: block.settings.enable_highlight,
                          hl_animateWrap: true -%}
                        </div>
                        {%- if block.settings.menu != blank -%}
                          <ul class="footer-block__details-content list-unstyled">
                            {%- for link in block.settings.menu.links -%}
                              <li>
                                <a href="{{ link.url }}" class="link list-menu__item list-menu__item--link{% if link.active %} list-menu__item--active{% endif %}">
                                  {{ link.title }}
                                </a>
                              </li>
                            {%- endfor -%}
                          </ul>
                        {%- endif -%}
                      </div>
                        {%- endcase-%}
                {%- endfor -%}
              </div>
              {% comment %} {%- for block in section.blocks -%}
                <footer-accordion class="accordion footer-block grid__item{% if block.type == 'link_list' %} footer-block--menu{% endif %}" {{ block.shopify_attributes }}>
                  <!-- <details open> -->
                    <summary tabindex="-1">
                      <p class="h4 accordion__title">
                        {%- render 'highlight-text', 
                          hl_input: block.settings.heading, 
                          hl_style: block.settings.highlight_style,
                          hl_enable: block.settings.enable_highlight,
                          hl_animateWrap: true -%}
                      </p>
                      {% comment %}{% render 'icon', icon: 'caret' %} {% endcomment %}
                    </summary>
                    {%- case block.type -%}
                      {%- when 'text' -%}
                        <div class="footer-block__details-content rte">
                          {%- render 'highlight-text', 
                            hl_input: block.settings.subtext, 
                            hl_style: block.settings.highlight_style,
                            hl_enable: block.settings.enable_highlight,
                            hl_animateWrap: true -%}
                        </div>
                      {%- when 'link_list' -%}
                        {%- if block.settings.menu != blank -%}
                          <ul class="footer-block__details-content list-unstyled">
                            {%- for link in block.settings.menu.links -%}
                              <li>
                                <a href="{{ link.url }}" class="link list-menu__item list-menu__item--link{% if link.active %} list-menu__item--active{% endif %}">
                                  {{ link.title }}
                                </a>
                              </li>
                            {%- endfor -%}
                          </ul>
                        {%- endif -%}
                      {%- when 'image' -%}
                        <div class="footer-block__details-content footer-block-image {{ block.settings.alignment }}">
                          {%- if block.settings.link != blank -%}
                            <a href="{{ block.settings.link }}">
                          {%- endif -%}
                            {%- if block.settings.image != blank -%}
                              {%- liquid
                                assign image_width = block.settings.image_width
                                assign image_width_2x = block.settings.image_width | times: 2
                              -%}
                              <img
                                srcset= "{{ block.settings.image | image_url: width: image_width }}, {{ block.settings.image | image_url: width: image_width_2x }} 2x"
                                src="{{ block.settings.image | image_url: width: image_width }}"
                                alt="{{ block.settings.image.alt | escape }}"
                                loading="lazy"
                                width="{{ block.settings.image.width }}"
                                height="{{ block.settings.image.height }}"
                                style="max-width: min(100%, {{ image_width }}px);"
                              />
                            {%- else -%}
                              {{ 'image' | placeholder_svg_tag: 'placeholder' }}
                            {%- endif -%}
                          {%- if block.settings.link != blank -%}
                            </a>
                          {%- endif -%}
                          <p class="caption-large">
                            {%- render 'highlight-text', 
                              hl_input: block.settings.text, 
                              hl_style: block.settings.highlight_style,
                              hl_enable: block.settings.enable_highlight,
                              hl_animateWrap: true -%}
                          </p>

                          {% comment %} Newsletter code start {% endcomment %}
                          <div class="newsletter_f_sec">
                            {% if section.settings.newsletter_heading != blank %}
                            <h4>{{section.settings.newsletter_heading }}</h4>
                            {% endif %}
                            <div class="footer-block__details-content">
                              <div class="footer-block__newsletter">
                                {%- assign return_url = section.settings.return_url | default: 'back' | append: '' -%}
                                {%- form 'customer', id: 'ContactFooter', class: 'footer__newsletter newsletter-form', return_to: return_url -%}
                                  <input type="hidden" name="contact[tags]" value="newsletter"/>

                                  <div class="field">
                                    <input
                                      id="ContactFooter-email"
                                      type="email"
                                      name="contact[email]"
                                      class="field__input required{% if form.errors %} invalid{% endif %}"
                                      value="{{ form.email }}"
                                      aria-required="true"
                                      autocorrect="off"
                                      autocapitalize="off"
                                      autocomplete="email"
                                      {% if form.errors %}
                                        autofocus
                                        aria-invalid="true"
                                        aria-describedby="ContactFooter-error"
                                      {% elsif form.posted_successfully? %}
                                        aria-describedby="ContactFooter-success"
                                      {% endif %}
                                      placeholder="{{ 'newsletter.label' | t }}"
                                      required
                                    />
                                    <label class="visually-hidden" for="ContactFooter-email">{{ 'newsletter.label' | t }}</label>
                                    <button type="submit" class="button button--arrow field__button animate-arrow" name="commit" aria-label="{{ 'newsletter.button_label' | t }}">
                                      {% render 'icon', icon: 'arrow' %}
                                    </button>
                                  </div>
                                  {%- if form.errors -%}
                                    <small class="form__message errors" id="ContactFooter-error">
                                      {% render 'icon', icon: 'error' %}
                                      {{ form.errors.translated_fields['email'] | capitalize }} {{ form.errors.messages['email'] }}
                                    </small>
                                  {%- endif -%}
                                  
                                  <div class="typeset rte">
                                    {%- render 'highlight-text', 
                                      hl_input: section.settings.newsletter_text, 
                                      hl_style: section.settings.highlight_style,
                                      hl_enable: section.settings.enable_highlight,
                                      hl_animateWrap: true -%}
                                  </div>

                                  {%- if form.posted_successfully? -%}
                                    <p class="form__message h3" id="ContactFooter-success" tabindex="-1" autofocus>
                                      {% render 'icon', icon: 'success' %}
                                      {{ 'newsletter.success' | t }}
                                    </p>
                                  {%- endif -%}
                                  
                                {%- endform -%}
                              </div>
                            </div>
                          </div>
                          {% comment %} Newsletter code end {% endcomment %}

                          <ul class="footer__list-social list-unstyled list-social" role="list">
                            {% render 'social-icons' %}
                            <li class="list-social__item--placeholder">{{ 'sections.footer.social_placeholder' | t }}</li>
                          </ul>

                        </div>
                    {%- endcase -%}
                  <!-- </details> -->
                </footer-accordion>
              {%- endfor -%} {% endcomment %}
            </div>
          </div>
        {%- endif -%}

        {% comment %} Mobile Follow us start {% endcomment %}
        <div class="mob_f_follow_us">
          <div class="f_follow_us">
            <div class="f_follow_us_title">FOLLOW US</div>
            <ul class="footer__list-social list-unstyled list-social" role="list">
              {% render 'social-icons' %}
              <li class="list-social__item--placeholder">{{ 'sections.footer.social_placeholder' | t }}</li>
            </ul>
          </div>
        </div>
        {% comment %} Mobile Follow us end {% endcomment %}

        {%- if enable_right_column -%}
          <div class="grid__item footer__content-right">
            <div class="grid">
              {%- if section.blocks.size > 0 -%}
                <div class="grid__item small-hide">
                  <div></div>
                </div>
              {%- endif -%}
              <div class="grid__item">
                {%- if section.settings.newsletter_enable -%}
                  <footer-accordion class="accordion footer-block--newsletter" data-open>
                    <details open>
                      <summary tabindex="-1">
                        <p class="h4 accordion__title">
                          {%- render 'highlight-text', 
                            hl_input: section.settings.newsletter_heading, 
                            hl_style: section.settings.highlight_style,
                            hl_enable: section.settings.enable_highlight,
                            hl_animateWrap: true -%}
                        </p>
                        {% render 'icon', icon: 'caret' %}
                      </summary>
                      <div class="footer-block__details-content">
                        <div class="footer-block__newsletter">
                          {%- assign return_url = section.settings.return_url | default: 'back' | append: '' -%}
                          {%- form 'customer', id: 'ContactFooter', class: 'footer__newsletter newsletter-form', return_to: return_url -%}
                            <input type="hidden" name="contact[tags]" value="newsletter"/>

                            <div class="field">
                              <input
                                id="ContactFooter-email"
                                type="email"
                                name="contact[email]"
                                class="field__input required{% if form.errors %} invalid{% endif %}"
                                value="{{ form.email }}"
                                aria-required="true"
                                autocorrect="off"
                                autocapitalize="off"
                                autocomplete="email"
                                {% if form.errors %}
                                  autofocus
                                  aria-invalid="true"
                                  aria-describedby="ContactFooter-error"
                                {% elsif form.posted_successfully? %}
                                  aria-describedby="ContactFooter-success"
                                {% endif %}
                                placeholder="Enter email id"
                                required
                              />
                              <label class="visually-hidden" for="ContactFooter-email">{{ 'newsletter.label' | t }}</label>
                              <button type="submit" class="button button--arrow field__button animate-arrow" name="commit" aria-label="{{ 'newsletter.button_label' | t }}">
                                {% render 'icon', icon: 'arrow' %}
                              </button>
                            </div>
                            {%- if form.errors -%}
                              <small class="form__message errors" id="ContactFooter-error">
                                {% render 'icon', icon: 'error' %}
                                {{ form.errors.translated_fields['email'] | capitalize }} {{ form.errors.messages['email'] }}
                              </small>
                            {%- endif -%}
                            
                            <div class="typeset rte">
                              {%- render 'highlight-text', 
                                hl_input: section.settings.newsletter_text, 
                                hl_style: section.settings.highlight_style,
                                hl_enable: section.settings.enable_highlight,
                                hl_animateWrap: true -%}
                            </div>

                            {%- if form.posted_successfully? -%}
                              <p class="form__message h3" id="ContactFooter-success" tabindex="-1" autofocus>
                                {% render 'icon', icon: 'success' %}
                                {{ 'newsletter.success' | t }}
                              </p>
                            {%- endif -%}
                            
                          {%- endform -%}
                        </div>
                        {%- if section.settings.show_social -%}
                          <p class="h4 accordion__title">
                            {%- render 'highlight-text', 
                              hl_input: section.settings.social_heading, 
                              hl_style: section.settings.highlight_style,
                              hl_enable: section.settings.enable_highlight,
                              hl_animateWrap: true -%}
                          </p>
                          <ul class="footer__list-social list-unstyled list-social" role="list">
                            {% render 'social-icons' %}
                            <li class="list-social__item--placeholder">{{ 'sections.footer.social_placeholder' | t }}</li>
                          </ul>
                        {%- endif -%}
                        {%- if shop.features.follow_on_shop? and section.settings.enable_follow_on_shop -%}
                          <div class="footer__follow-on-shop">
                            {% comment %} TODO: enable theme-check once `login_button` is accepted as valid filter {% endcomment %}
                            {% # theme-check-disable %}
                            {{ shop | login_button: action: 'follow' }}
                            {% # theme-check-enable %}
                          </div>
                        {%- endif -%}
                      </div>
                    </details>
                  </footer-accordion>
                {%- else -%}
                  <footer-accordion class="accordion footer-block--social" data-open>
                    <details open>
                      <summary tabindex="-1">
                        <p class="h4 accordion__title">{{ section.settings.social_heading | escape }}</p>
                        {% render 'icon', icon: 'caret' %}
                      </summary>
                      <div class="footer-block__details-content">
                        <ul class="footer__list-social list-unstyled list-social" role="list">
                          {% render 'social-icons' %}
                          <li class="list-social__item--placeholder">{{ 'sections.footer.social_placeholder' | t }}</li>
                        </ul>
                        </div>
                    </details>
                  </footer-accordion>
                {%- endif -%}
              </div>
            </div>
          </div>
        {%- endif -%}
      </div>
    </div>
  {%- endif -%}

  <div class="footer__content-bottom">
      <div class="inner_d">
        <div class="copyright_text">
            Beyond Beyond is a brand registered as a subsidiary under its parent company, <br>Fyremist Pvt. Ltd. © {{ 'now' | date: '%Y' }} All Rights Reserved
        </div>
        <div class="paymentIcons">
          <div><img src="https://cdn.shopify.com/s/files/1/0715/1157/2666/files/UPI_1.png?v=1752040164"></div>
          <div><img src="https://cdn.shopify.com/s/files/1/0715/1157/2666/files/48.svg?v=1752039583"></div>
          <div><img src="https://cdn.shopify.com/s/files/1/0715/1157/2666/files/48_a0e090f7-5b9a-4d1f-bfdd-f7d0021b2394.svg?v=1752039605"></div>
          <div><img src="https://cdn.shopify.com/s/files/1/0715/1157/2666/files/48_e2785efd-7a35-4fcc-a5a7-b314f3698722.svg?v=1756106423"></div>
          <div><img src="https://cdn.shopify.com/s/files/1/0715/1157/2666/files/48_badde055-6773-4278-830f-5b088cbe8623.svg?v=1752039813"></div>
          <div><img src="https://cdn.shopify.com/s/files/1/0715/1157/2666/files/48_346e8aca-b0b5-46cf-a04a-e7b8a56bc23f.svg?v=1752039832"></div>
        </div>
      </div>
      {% comment %}
    <div class="footer__content-bottom-wrapper page-width">
      <div class="footer__column footer__column--info">
        <div class="footer__copyright">
          <small class="copyright__content">&copy; {{ 'now' | date: "%Y" }}, {{ shop.name | link_to: routes.root_url }}. {{ section.settings.copyright_text }}</small>
          <ul class="policies list-unstyled">
            <li><small class="copyright__content">{{ powered_by_link }}</small></li>
            {%- if section.settings.show_policy -%}
              {%- for policy in shop.policies -%}
                {%- if policy != blank -%}
                  <li><small class="copyright__content"><a href="{{ policy.url }}">{{ policy.title }}</a></small></li>
                {%- endif -%}
              {%- endfor -%}
            {%- endif -%}
          </ul>
        </div>
      </div>
      <div class="footer__column footer__column--extra">
        <div class="footer__localization">
          {%- if section.settings.enable_language_selector and localization.available_languages.size > 1 -%}
            <noscript>
              {%- form 'localization', id: 'FooterLanguageFormNoScript', class: 'localization-form' -%}
                <div class="localization-form__select">
                  <p class="visually-hidden" id="FooterLanguageLabelNoScript">{{ 'localization.language_label' | t }}</p>
                  <select class="localization-selector link" name="locale_code" aria-labelledby="FooterLanguageLabelNoScript">
                    {%- for language in localization.available_languages -%}
                      <option value="{{ language.iso_code }}" lang="{{ language.iso_code }}" {%- if language.iso_code == localization.language.iso_code %} selected{% endif %}>
                        {{ language.endonym_name | capitalize }}
                      </option>
                    {%- endfor -%}
                  </select>
                  {% render 'icon', icon: 'caret' %}
                </div>
                <button class="button button--tertiary">{{ 'localization.update_language' | t }}</button>
              {%- endform -%}
            </noscript>
            <localization-form>
              {%- form 'localization', id: 'FooterLanguageForm', class: 'localization-form' -%}
                <div class="no-js-hidden">
                  <span class="visually-hidden" id="FooterLanguageLabel">{{ 'localization.language_label' | t }}</span>
                  <div class="disclosure">
                    <button type="button" class="disclosure__button localization-form__select localization-selector link link--text link-with-icon" aria-expanded="false" aria-controls="FooterLanguageList" aria-describedby="FooterLanguageLabel">
                      {% render 'icon', icon: 'localization' %}
                      <span class="label">{{ localization.language.endonym_name | capitalize }}</span>
                      {% render 'icon', icon: 'caret' %}
                    </button>
                    <ul id="FooterLanguageList" role="list" class="disclosure__list list-unstyled" hidden>
                      <li class="disclosure__item" tabindex="-1">
                        <a class="disclosure__link link disclosure__link--active focus-inset" href="#" hreflang="{{ localization.language.iso_code }}" lang="{{ localization.language.iso_code }}" aria-current="true" data-value="{{ localization.language.iso_code }}">
                          {{ localization.language.endonym_name | capitalize }}
                        </a>
                      </li>
                      {%- for language in localization.available_languages -%}
                        {%- if language.iso_code != localization.language.iso_code -%}
                          <li class="disclosure__item" tabindex="-1">
                            <a class="disclosure__link link focus-inset" href="#" hreflang="{{ language.iso_code }}" lang="{{ language.iso_code }}" data-value="{{ language.iso_code }}">
                              {{ language.endonym_name | capitalize }}
                            </a>
                          </li>
                        {%- endif -%}
                      {%- endfor -%}
                    </ul>
                  </div>
                  <input type="hidden" name="locale_code" value="{{ localization.language.iso_code }}"/>
                </div>
              {%- endform -%}
            </localization-form>
          {%- endif -%}

          {%- if section.settings.enable_country_selector and localization.available_countries.size > 1 -%}
            <noscript>
              {%- form 'localization', id: 'FooterCountryFormNoScript', class: 'localization-form' -%}
                <div class="localization-form__select">
                  <p class="visually-hidden" id="FooterCountryLabelNoScript">{{ 'localization.country_label' | t }}</p>
                  <select class="localization-selector link" name="country_code" aria-labelledby="FooterCountryLabelNoScript">
                    {%- for country in localization.available_countries -%}
                      <option value="{{ country.iso_code }}" {%- if country.iso_code == localization.country.iso_code %} selected{% endif %}>
                        {{ country.currency.iso_code }} {{ country.currency.symbol }}
                      </option>
                    {%- endfor -%}
                  </select>
                  {% render 'icon', icon: 'caret' %}
                </div>
                <button class="button button--tertiary">{{ 'localization.update_country' | t }}</button>
              {%- endform -%}
            </noscript>
            <localization-form>
              {%- form 'localization', id: 'FooterCountryForm', class: 'localization-form' -%}
                <div class="no-js-hidden">
                  <span class="visually-hidden" id="FooterCountryLabel">{{ 'localization.country_label' | t }}</span>
                  <div class="disclosure">
                    <button type="button" class="disclosure__button localization-form__select localization-selector link link--text link-with-icon" aria-expanded="false" aria-controls="FooterCountryList" aria-describedby="FooterCountryLabel">
                      {%- unless section.settings.enable_language_selector and localization.available_languages.size > 1 -%}
                        {% render 'icon', icon: 'localization' %}
                      {%- endunless -%}
                      <span class="label">{{ localization.country.name }} ({{ localization.country.currency.iso_code }} {{ localization.country.currency.symbol }})</span>
                      {% render 'icon', icon: 'caret' %}
                    </button>
                    <ul id="FooterCountryList" role="list" class="disclosure__list list-unstyled" hidden>
                      <li class="disclosure__item" tabindex="-1">
                        <a class="disclosure__link link disclosure__link--active focus-inset" href="#" aria-current="true" data-value="{{ localization.country.iso_code }}">
                          {{ localization.country.name }} ({{ localization.country.currency.iso_code }} {{ localization.country.currency.symbol }})
                        </a>
                      </li>
                      {%- for country in localization.available_countries -%}
                        {%- if country.iso_code != localization.country.iso_code -%}
                          <li class="disclosure__item" tabindex="-1">
                            <a class="disclosure__link link focus-inset" href="#" data-value="{{ country.iso_code }}">
                              {{ country.name }} ({{ country.currency.iso_code }} {{ country.currency.symbol }})
                            </a>
                          </li>
                        {%- endif -%}
                      {%- endfor -%}
                    </ul>
                  </div>
                  <input type="hidden" name="country_code" value="{{ localization.country.iso_code }}"/>
                </div>
              {%- endform -%}
            </localization-form>
          {%- endif -%}
        </div>

        {%- if section.settings.payment_enable -%}
          <div class="footer__payment">
            <span class="visually-hidden">{{ 'sections.footer.payment' | t }}</span>
            <ul class="list list-payment" role="list">
              {%- for type in shop.enabled_payment_types -%}
                <li class="list-payment__item">
                  {{ type | payment_type_svg_tag: class: 'icon icon--full-color' }}
                </li>
              {%- endfor -%}
            </ul>
          </div>
        {%- endif -%}
      </div>
    </div>
    {% endcomment %}
  </div>
</footer>

