{% if section.settings.show_product_blog_slider_sec != blank %}
<div class="proBlogSliderSec">
  <div class="page-width">
    {% if section.settings.title != blank %}
    <div class="section_header">
        <h2 class="sub_title_name">{{ section.settings.title }}</h2>
    </div>
    {% endif %}
    <div class="swiper blogSlider proBlogSlider_{{ section.id }}">
      <div class="swiper-wrapper">
        {%- for article in section.settings.blog.articles limit: 6 -%}
        <div class="swiper-slide">
          <div class="item_d">
            <a href="{{ article.url }}">
              <div class="blog_img">
                <img src="{{ article.metafields.custom.main_image | img_url:"master" }}" class="hidden-xs">
                <img src="{{ article.metafields.custom.main_mobile_image | img_url:"master" }}" class="visible-xs">
              </div>
              <h4>{{ article.title }}</h4>
            </a>
          </div>
        </div>
        {% endfor %}
      </div>
      <div class="swiper-pagination swiper-pagination-blog"></div>
    </div>
  </div>
</div>
{% endif %}

<script>
    var swiper = new Swiper('.proBlogSlider_{{ section.id }}', {
      slidesPerView: 1.5,
      spaceBetween: 24,
      slidesOffsetBefore: 24,
       // If we need pagination
    pagination: {
      el: '.swiper-pagination-blog',
      clickable: true,
    },
      breakpoints: {
      768: {
        slidesPerView:3,
        spaceBetween: 20,
      slidesOffsetBefore: 0,
      },
      1200: {
        slidesPerView: 3,
         spaceBetween: 137,
      slidesOffsetBefore: 0,
      },
    }
    });
</script>
{% schema %}
{
  "name": "Product Blog Slider Sec",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_product_blog_slider_sec",
      "label": "Show Product Blog Slider Sec",
      "default": true
    },
    {
      "type": "blog",
      "id": "blog",
      "label": "Blog"
    },
    {
      "type": "text",
      "id": "title",
      "label": "title"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description"
    },
  ],
  "presets": [
    {
      "name": "Product Blog Slider Sec",
      "category": "Custom"
    }
  ]
}
{% endschema %}