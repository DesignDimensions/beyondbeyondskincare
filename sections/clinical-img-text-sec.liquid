{% if section.settings.show_clinical_img_text_sec != blank %}
<div class="clinicalImgTextSec {% if section.settings.show_image_to_right != blank %} setImgPosition {% endif %}">
  <div class="inner_d">
    {% if section.settings.image != blank %}
    <div class="img_d">
      <img src="{{ section.settings.image | img_url:"master" }}">
    </div>
    {% endif %}
  <div class="content_d">
    {% if section.settings.title != blank %}
    <h4 class="sub_title_name">{{ section.settings.title }}</h4>
    {% endif %}
    {% if section.settings.sub_title != blank %}
    <h5>{{ section.settings.sub_title }}</h5>
    {% endif %}
    {% if section.settings.description != blank %}
    <div class="desc">{{ section.settings.description }}</div>
    {% endif %}
  </div>
  </div>
</div>
{% endif %}
{% schema %}
{
  "name": "Clinical Img Text Sec",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_clinical_img_text_sec",
      "label": "Show Clinical Img Text Sec",
      "default": true
    },
    {
      "type": "textarea",
      "id": "title",
      "label": "title"
    },
    {
      "type": "textarea",
      "id": "sub_title",
      "label": "Sub title"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "checkbox",
      "id": "show_image_to_right",
      "label": "Show Img To Right",
      "default": true
    },
  ],
  "presets": [
    {
      "name": "Clinical Img Text Sec",
      "category": "Custom"
    }
  ]
}
{% endschema %}