    "home_ingredient_sec_W3ELyU": {
      "type": "home-ingredient-sec",
      "blocks": {
        "image_block_GR9qJA": {
          "type": "image-block",
          "settings": {
            "image": "shopify://shop_images/910a609eddbf737394353922c2d96392.png",
            "title": "Clinically Advanced <b>NAD+</b>",
            "description": "At the heart of our formulation lies NAD+ — a coenzyme found in every living cell, but one that declines as we age. Sourced through precision extraction, this ultra-stable form works at the cellular level to energise skin, repair oxidative damage, and restore youthful function. Its presence doesn’t just support the skin — it awakens it, pushing each cell to regenerate as you sleep."
          }
        },
        "image_block_qPD6pk": {
          "type": "image-block",
          "settings": {
            "image": "shopify://shop_images/e0e393b63ab3d8af21afde411e1063c9.png",
            "title": "Squalane-Infused Skin Science",
            "description": "Derived from high-purity olives, our bioidentical Squalane mimics the skin's natural sebum. It delivers deep, weightless hydration while reinforcing the lipid barrier - locking in moisture and restoring elasticity. It's the reason your skin wakes up dewy, not dry."
          }
        },
        "image_block_yhnGL7": {
          "type": "image-block",
          "settings": {
            "image": "shopify://shop_images/fbc079913c2702254001d3e0ccc03d6e.png",
            "title": "Cocoa Butter",
            "description": "More than just a moisturiser, Cocoa Butter is a rich emollient packed with polyphenols. It conditions dry, fatigued skin, enhances tone, and delivers antioxidant defence - making it essential to skin that's constantly exposed to stress."
          }
        },
        "image_block_4VgFcV": {
          "type": "image-block",
          "settings": {
            "image": "shopify://shop_images/978ebfd9c5369c408db87cd0ffcf6974.png",
            "title": "Shea Butter",
            "description": "Unrefined and nutrient-dense, Shea Butter lends softness, calm, and healing to compromised skin. With its abundance of vitamin A and E, it soothes irritation, rebuilds lost moisture, and leaves the skin comforted and resilient by dawn."
          }
        },
        "image_block_hJGkwk": {
          "type": "image-block",
          "settings": {
            "image": "shopify://shop_images/3af2d748673bec6efb570621d8d0ad16.png",
            "title": "Glycerine",
            "description": "Often overlooked, never underestimated - Glycerin draws water into the skin like a magnet. As a powerful humectant, it supports all other actives by keeping the skin environment optimally hydrated, improving absorption and long-lasting suppleness."
          }
        },
        "image_block_mJGh4P": {
          "type": "image-block",
          "settings": {
            "image": "shopify://shop_images/ed0a35d2dcdf51b3260d47db864780b9.png",
            "title": "Petrolatum",
            "description": "Pharmaceutical-grade and dermatologist-approved, Petrolatum creates an occlusive cocoon over the skin. It seals in hydration and shields the surface, allowing actives beneath to perform without interruption. Think of it as overnight insurance for your skin barrier."
          }
        }
      },
