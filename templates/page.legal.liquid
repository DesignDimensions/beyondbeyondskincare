  <script>
    document.addEventListener("DOMContentLoaded", function () {
      if (window.innerWidth <= 768) return; // Run only on screens wider than 768px

      const navItems = document.querySelectorAll(".legal__page .dropdown li");
      const sections = document.querySelectorAll(".legal__page .inner_d");

      function updateActiveFromHash(hash) {
      navItems.forEach(li => {
        const a = li.querySelector("a");
        li.classList.toggle("active", a.getAttribute("href") === hash);
      });

      sections.forEach(section => {
        const match = "#" + section.id === hash;
        section.classList.toggle("active", match);

        // Scroll to matching section
        if (match) {
          section.scrollIntoView({ behavior: "smooth", block: "start" });
        }
      });
    }

    // On link click
    navItems.forEach(li => {
      const a = li.querySelector("a");
      a.addEventListener("click", function (e) {
        e.preventDefault();
        const hash = this.getAttribute("href");

        history.pushState(null, null, hash);
        updateActiveFromHash(hash);
      });
    });

    // On page load if hash exists
    if (window.location.hash) {
      updateActiveFromHash(window.location.hash);
    }

    // On hash change (if user uses browser back/forward buttons)
    window.addEventListener("hashchange", function () {
      updateActiveFromHash(window.location.hash);
    });
  });
  </script>

<script>
  function initDropdownForMobile() {
    const dropdown = document.getElementById("policyDropdown");
    const button = document.getElementById("dropdownButton");
    const listItems = dropdown.querySelectorAll(".dropdown-content li");
    const links = dropdown.querySelectorAll(".dropdown-content a");

    // Reset event listeners if already bound
    const newButton = button.cloneNode(true);
    button.parentNode.replaceChild(newButton, button);

    newButton.addEventListener("click", () => {
      dropdown.classList.toggle("show");
    });

    links.forEach(link => {
      link.addEventListener("click", function (e) {
        e.preventDefault();

        // Update button text
        newButton.textContent = this.textContent;

        // Remove active from all, add to selected
        listItems.forEach(item => item.classList.remove("active"));
        this.parentElement.classList.add("active");

        // Close dropdown
        dropdown.classList.remove("show");

        // Optional scroll to target
        const targetId = this.getAttribute("href").substring(1);
        const target = document.getElementById(targetId);
        if (target) {
          target.scrollIntoView({ behavior: "smooth" });
        }
      });
    });

    // Close if clicked outside
    window.addEventListener("click", (e) => {
      if (!dropdown.contains(e.target)) {
        dropdown.classList.remove("show");
      }
    });
  }

  // Run only if screen width is <= 767px
  function checkScreenAndInitDropdown() {
    if (window.innerWidth <= 768) {
      initDropdownForMobile();
    }
  }

  window.addEventListener("load", checkScreenAndInitDropdown);
  window.addEventListener("resize", checkScreenAndInitDropdown);
</script>